<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:DoViFixer.App.Presentation">
    <BooleanToVisibilityConverter x:Key="Visible" />
    <p:InverseBooleanToVisibilityConverter x:Key="InverseVisible" />
    <p:InverseBooleanConverter x:Key="Inverse" />
    <p:ReferenceEqualsToVisibilityConverter x:Key="ReferenceEqualsToVisibility" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
    <SolidColorBrush x:Key="Muted" Color="#808080" />
    <Style x:Key="Heading"
           TargetType="TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Label"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Primary"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}" />
    <Style x:Key="TransparentButton"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ControlStrongFillColorDefault}" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>