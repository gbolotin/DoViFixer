<!-- DoViFixer-specific resources. Shared styles, templates and converters come from the WpfFoundation entry dictionary (Wf* keys). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:DoViFixer.App.Dialogs">
    <DataTemplate DataType="{x:Type dialogs:ExistingOutputDialogViewModel}">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   MaxWidth="544" />
    </DataTemplate>

    <!-- A Segoe Fluent Icons glyph for a menu item, the same as the toolbar or row button that does the same. -->
    <Style x:Key="MenuGlyphIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultIconFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
