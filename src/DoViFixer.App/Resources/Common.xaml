<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:DoViFixer.App.Presentation.Common"
                    xmlns:cm="clr-namespace:System.ComponentModel;assembly=System.ComponentModel.TypeConverter">
    <BooleanToVisibilityConverter x:Key="Visible" />
    <p:InverseBooleanToVisibilityConverter x:Key="InverseVisible" />
    <p:InverseBooleanConverter x:Key="Inverse" />
    <p:ReferenceEqualsToVisibilityConverter x:Key="ReferenceEqualsToVisibility" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" />
    <SolidColorBrush x:Key="Muted" Color="#808080" />
    <DataTemplate x:Key="IconButtonContent">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                       FontSize="16"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="AddIconButtonContent">
        <StackPanel Orientation="Horizontal">
            <Grid Width="24"
                  Height="20"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                           FontSize="16"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top">
                    <TextBlock.Clip>
                        <GeometryGroup FillRule="EvenOdd">
                            <RectangleGeometry Rect="0,0,16,16" />
                            <EllipseGeometry Center="18,14"
                                             RadiusX="7"
                                             RadiusY="7" />
                        </GeometryGroup>
                    </TextBlock.Clip>
                </TextBlock>
                <Border Width="12"
                        Height="12"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="&#xE710;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="8"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <Style x:Key="Heading"
           TargetType="TextBlock"
           BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Label"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Primary"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}" />
    <Style x:Key="TransparentButton"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ControlStrongFillColorDefault}" />
        </Style.Resources>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        Sortable GridView lists. Usage:
          <ListView p:GridViewSort.Sort="{Binding MySort}">      (MySort is a ColumnSort<TItem>)
            <GridView ColumnHeaderTemplate="{StaticResource SortableColumnHeader}">
              <GridViewColumn Header="Name" p:GridViewSort.Key="{x:Static local:MyColumn.Name}" />
        Columns with their own HeaderTemplate add <TextBlock Style="{StaticResource ColumnSortIndicator}" />.
    -->
    <Style x:Key="ColumnSortIndicator" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="p:GridViewSort.ShowsColumnDirection" Value="True" />
        <Style.Triggers>
            <Trigger Property="p:GridViewSort.Direction" Value="{x:Static cm:ListSortDirection.Ascending}">
                <Setter Property="Text" Value="&#xE70E;" />
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="p:GridViewSort.Direction" Value="{x:Static cm:ListSortDirection.Descending}">
                <Setter Property="Text" Value="&#xE70D;" />
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SortableColumnHeader">
        <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource ColumnSortIndicator}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
