<!-- DoViFixer-specific resources. Shared styles, templates and converters come from the WpfFoundation entry dictionary (Wf* keys). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:DoViFixer.App.Dialogs"
                    xmlns:activity="clr-namespace:DoViFixer.Application.Activity;assembly=DoViFixer.Application">
    <!-- An activity entry's dot: green when done, amber for a problem, red when it failed, accent while running. -->
    <Style x:Key="ActivityDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static activity:ActivitySeverity.Success}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static activity:ActivitySeverity.Warning}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="{x:Static activity:ActivitySeverity.Error}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One activity entry, in the status bar's Activity flyout and in a file's details: what happened, when, and why. -->
    <DataTemplate x:Key="ActivityEntryTemplate" DataType="{x:Type activity:ActivityEntry}">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Ellipse Style="{StaticResource ActivityDotStyle}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       TextWrapping="Wrap" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Time.LocalDateTime, StringFormat=t}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
            <TextBlock x:Name="Detail"
                       Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Text="{Binding Detail}"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Detail}" Value="">
                <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dialogs:ExistingOutputDialogViewModel}">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   MaxWidth="544" />
    </DataTemplate>

    <!-- A Segoe Fluent Icons glyph for a menu item, the same as the toolbar or row button that does the same. -->
    <Style x:Key="MenuGlyphIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DefaultIconFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
