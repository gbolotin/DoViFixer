<!-- DoViFixer-specific resources. Shared styles, templates and converters come from the WpfFoundation entry dictionary (Wf* keys). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:DoViFixer.App.Dialogs">
    <DataTemplate DataType="{x:Type dialogs:ExistingOutputDialogViewModel}">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   MaxWidth="544" />
    </DataTemplate>
</ResourceDictionary>
