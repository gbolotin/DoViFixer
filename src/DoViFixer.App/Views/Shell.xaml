<Window x:Class="DoViFixer.App.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoViFixer"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{DynamicResource ApplicationBackgroundBrush}"
               TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border DockPanel.Dock="Left"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="0,0">
            <DockPanel>
                <ListBox x:Name="Navigation"
                         DockPanel.Dock="Top"
                         SelectedIndex="0"
                         SelectionChanged="Navigate"
                         SelectionMode="Single"
                         IsEnabled="{Binding CanNavigate}">
                    <ListBoxItem Content="Media" Tag="Media" />
                    <ListBoxItem Content="Backup &amp; Restore" Tag="Archive"/>
                    <ListBoxItem Content="Settings" Tag="Settings"/>
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl x:Name="Workspace" Margin="8,0" />
    </DockPanel>
</Window>
