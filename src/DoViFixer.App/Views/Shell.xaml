<Window x:Class="DoViFixer.App.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        Title="DoViFixer"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <DockPanel Background="{StaticResource Canvas}">
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1"
                Padding="26,20">
            <DockPanel>
                <TextBlock Text="◈  DoViFixer"
                           FontSize="28"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left"
                           Margin="0,0,80,0" />
                <StackPanel x:Name="Navigation"
                            Orientation="Horizontal"
                            IsEnabled="{Binding CanNavigate}">
                    <Button Content="Media"
                            Tag="Media"
                            Click="Navigate"
                            BorderBrush="{StaticResource Accent}" />
                    <Button Content="Backup &amp; Restore"
                            Tag="Archive"
                            Click="Navigate" />
                    <Button Content="Settings"
                            Tag="Settings"
                            Click="Navigate" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl prism:RegionManager.RegionName="Workspace" Margin="20" />
    </DockPanel>
</Window>
