<Window x:Class="DoViFixer.App.Views.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
        xmlns:views="clr-namespace:DoViFixer.App.Views"
        xmlns:p="clr-namespace:DoViFixer.App.Presentation.Application"
        xmlns:updates="clr-namespace:DoViFixer.Application.Updates;assembly=DoViFixer.Application"
        xmlns:navigation="clr-namespace:WpfFoundation.Navigation;assembly=WpfFoundation"
        xmlns:wf="clr-namespace:WpfFoundation.Controls;assembly=WpfFoundation"
        Icon="pack://application:,,,/DoViFixer.App;component/dovifixer.ico"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <!-- Ctrl+comma opens Settings, as in Windows apps such as Visual Studio Code and Windows Terminal.
         F4 inspects and F5 converts the checked files, from the File menu and the Media toolbar alike. -->
    <Window.InputBindings>
        <KeyBinding Key="OemComma"
                    Modifiers="Control"
                    Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Key="F4" Command="{Binding InspectCommand}" />
        <KeyBinding Key="F5" Command="{Binding ConvertCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <!-- The Media page shows its UserControl; the navigation host creates it once and keeps it.
                 Settings shows in the frame over the page. -->
            <DataTemplate DataType="{x:Type viewModels:MediaViewModel}">
                <views:MediaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ShellViewModel}">
                <DockPanel>
                    <!-- The menu sits in the title bar on the Fluent backdrop, or below the system title bar in high contrast.
                         Like the page, it takes no input while the settings frame is open. -->
                    <wf:TitleBar DockPanel.Dock="Top">
                        <wf:TitleBar.RightHeader>
                            <Button Content="&#xE713;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Padding="12,4"
                                    Command="{Binding OpenSettingsCommand}"
                                    ToolTip="Settings (Ctrl+,)"
                                    AutomationProperties.Name="Settings"
                                    AutomationProperties.AcceleratorKey="Ctrl+,"
                                    Style="{StaticResource WfSubtleButtonStyle}" />
                        </wf:TitleBar.RightHeader>
                        <Menu IsEnabled="{Binding IsSettingsOpen, Converter={StaticResource WfInverseBooleanConverter}}">
                            <MenuItem Header="_File">
                                <!-- Icons match the Media toolbar buttons that do the same. -->
                                <MenuItem Header="_Add files…" Command="{Binding AddFilesCommand}">
                                    <MenuItem.Icon>
                                        <wf:PathIcon Data="{StaticResource WfIconAddFiles}" Size="{StaticResource DefaultIconFontSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Add _folder…" Command="{Binding AddFolderCommand}">
                                    <MenuItem.Icon>
                                        <wf:PathIcon Data="{StaticResource WfIconAddFolder}" Size="{StaticResource DefaultIconFontSize}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Re_scan all files" Command="{Binding RescanCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource MenuGlyphIconStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <!-- These act on the selected (checked) files, like the Media toolbar. -->
                                <MenuItem Header="_Inspect" Command="{Binding InspectCommand}" InputGestureText="F4">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE721;" Style="{StaticResource MenuGlyphIconStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Deep Inspect" Command="{Binding DeepInspectCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource MenuGlyphIconStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Convert" Command="{Binding ConvertCommand}" InputGestureText="F5">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource MenuGlyphIconStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Rest_ore to DV7…" Command="{Binding RestoreSelectedCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource MenuGlyphIconStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Remove" Command="{Binding RemoveSelectedCommand}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource MenuGlyphIconStyle}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="_Export results…" Command="{Binding ExportResultsCommand}" />
                                <Separator />
                                <MenuItem Header="E_xit"
                                          InputGestureText="Alt+F4"
                                          Click="OnExitClick" />
                            </MenuItem>
                            <MenuItem Header="_View">
                                <!-- Also in Settings > General. Without check boxes, the list selects files as File Explorer does. -->
                                <MenuItem Header="Show _check boxes"
                                          IsCheckable="True"
                                          IsChecked="{Binding Media.ShowsCheckBoxes}" />
                                <Separator />
                                <MenuItem Header="_Reset media columns" Command="{Binding Media.ResetColumnLayoutCommand}" />
                            </MenuItem>
                            <MenuItem Header="_Tools">
                                <MenuItem Header="_Settings"
                                          Command="{Binding OpenSettingsCommand}"
                                          InputGestureText="Ctrl+," />
                                <Separator />
                                <MenuItem Header="_Check dependencies" Command="{Binding CheckDependenciesCommand}" />
                                <MenuItem Header="C_lean library" Command="{Binding CleanLibraryCommand}" />
                                <MenuItem Header="Clean up _backups…" Command="{Binding CleanupBackupsCommand}" />
                            </MenuItem>
                            <MenuItem Header="_Help">
                                <MenuItem Header="Open _logs" Command="{Binding Settings.OpenLogsCommand}" />
                                <MenuItem Header="_Export diagnostics…" Command="{Binding ExportDiagnosticsCommand}" />
                                <Separator />
                                <MenuItem Header="{x:Static updates:ApplicationTitle.Name}"
                                          HeaderStringFormat="About {0}"
                                          Command="{Binding ShowAboutCommand}" />
                            </MenuItem>
                        </Menu>
                    </wf:TitleBar>
                    <Grid Background="{DynamicResource ApplicationBackgroundBrush}"
                          TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <!-- While the settings frame is open, the pages behind it take no keyboard, access key or screen reader focus. -->
                        <DockPanel IsEnabled="{Binding IsSettingsOpen, Converter={StaticResource WfInverseBooleanConverter}}">
                            <StatusBar ItemsSource="{Binding StatusItems}"
                                       DockPanel.Dock="Bottom"
                                       Style="{StaticResource WfStatusBarStyle}"
                                       AutomationProperties.Name="Page status">
                                <StatusBar.Resources>
                                    <!-- The Activity button opens a flyout of what happened this session, newest first. A red count
                                         shows problems reported since it was last opened. While the flyout is open the button takes
                                         no clicks, so clicking it closes the flyout instead of opening it again. -->
                                    <DataTemplate DataType="{x:Type viewModels:ActivityViewModel}">
                                        <Grid>
                                            <Button x:Name="ActivityButton"
                                                    Command="{Binding OpenCommand}"
                                                    IsHitTestVisible="{Binding IsOpen, ElementName=ActivityPopup, Converter={StaticResource WfInverseBooleanConverter}}"
                                                    ToolTip="{Binding ToolTip}"
                                                    AutomationProperties.Name="Activity"
                                                    AutomationProperties.HelpText="{Binding ToolTip}"
                                                    Style="{StaticResource WfTransparentButtonStyle}"
                                                    Padding="0"
                                                    MinHeight="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE81C;"
                                                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="Activity" VerticalAlignment="Center" />
                                                    <Border Background="{DynamicResource SystemFillColorCriticalBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}"
                                                            Padding="4,0"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding HasUnseenProblems, Converter={StaticResource WfBooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding UnseenProblems}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <Popup x:Name="ActivityPopup"
                                                   PlacementTarget="{Binding ElementName=ActivityButton}"
                                                   Placement="Top"
                                                   VerticalOffset="-8"
                                                   IsOpen="{Binding IsOpen}"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   PopupAnimation="Fade"
                                                   Opened="OnActivityPopupOpened">
                                                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource OverlayCornerRadius}"
                                                        Padding="16"
                                                        Width="440"
                                                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        AutomationProperties.Name="Activity">
                                                    <Border.InputBindings>
                                                        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                                                    </Border.InputBindings>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Top"
                                                                   Text="Activity"
                                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                                   Margin="0,0,0,12" />
                                                        <TextBlock DockPanel.Dock="Top"
                                                                   Text="Scans, inspections, conversions, restorations and cleanups you run appear here."
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding IsEmpty, Converter={StaticResource WfBooleanToVisibilityConverter}}" />
                                                        <ScrollViewer MaxHeight="480"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled">
                                                            <!-- The right margin keeps the overlay scroll bar off the entry times. -->
                                                            <ItemsControl ItemsSource="{Binding Entries}"
                                                                          Focusable="False"
                                                                          Margin="0,0,16,0"
                                                                          AutomationProperties.Name="Activity entries">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Margin="0,0,0,8">
                                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActivityEntryTemplate}" />
                                                                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                                                                                <TextBlock x:Name="ShowLocation"
                                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                                           Margin="0,0,12,0">
                                                                                    <Hyperlink Command="{Binding DataContext.ShowLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                               CommandParameter="{Binding}">
                                                                                        <Run Text="Show in folder" />
                                                                                    </Hyperlink>
                                                                                </TextBlock>
                                                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}">
                                                                                    <Hyperlink Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                               CommandParameter="{Binding}">
                                                                                        <Run Text="Copy" />
                                                                                    </Hyperlink>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding Location}" Value="{x:Null}">
                                                                                <Setter TargetName="ShowLocation" Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type p:DependencyReportViewModel}">
                                        <StackPanel Orientation="Horizontal"
                                                    ToolTip="{Binding WarningDetails}"
                                                    AutomationProperties.Name="Dependency warning"
                                                    AutomationProperties.LiveSetting="Polite">
                                            <TextBlock Text="&#xE7BA;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding WarningText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:StartupDependencyCheckViewModel}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Dependency operation">
                                            <TextBlock Text="{Binding StatusText}"
                                                       MaxWidth="320"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StatusText}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelCommand}"
                                                    AutomationProperties.Name="Cancel dependency operation"
                                                    Padding="8,0"
                                                    Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </StatusBar.Resources>
                            </StatusBar>
                            <navigation:RetainedPageHost Navigation="{Binding Navigation}" Margin="8,0,8,0" />
                        </DockPanel>
                        <!-- The title sits on the section list's background, as a small label above the sections. -->
                        <wf:ContentOverlay Header="Settings"
                                           Content="{Binding Settings}"
                                           IsOpen="{Binding IsSettingsOpen, Mode=OneWay}"
                                           CloseCommand="{Binding CloseSettingsCommand}"
                                           HeaderBackground="{DynamicResource ListBoxBackground}"
                                           CardMaxWidth="1040"
                                           CardMaxHeight="760"
                                           Padding="32">
                            <wf:ContentOverlay.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </wf:ContentOverlay.HeaderTemplate>
                        </wf:ContentOverlay>
                    </Grid>
                </DockPanel>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <ContentControl Content="{Binding}" />

</Window>
