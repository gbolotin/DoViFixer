<!-- The Media page's details panel, and the result dots it shares with the file list. MediaView merges this dictionary. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
                    xmlns:operations="clr-namespace:DoViFixer.Application.Operations;assembly=DoViFixer.Application">
    <!-- Detail values: plain text on every row except the file row, which shows a link instead. -->
    <Style x:Key="MediaDetailValueTextStyle" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Label}" Value="{x:Static viewModels:MediaRow.FileLocationLabel}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MediaDetailFileLinkTextStyle" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Label}" Value="{x:Static viewModels:MediaRow.FileLocationLabel}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Result dots: a small circle before a result's text, colored by how the operation ended. -->
    <Style x:Key="MediaResultDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <!-- Bound to an OperationItemResult. -->
    <Style x:Key="MediaOperationResultDotStyle"
           TargetType="Ellipse"
           BasedOn="{StaticResource MediaResultDotStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Completed}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Partial}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Cancelled}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Failed}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- Bound to a MediaRow; colored by risk and outcome. -->
    <Style x:Key="MediaRowResultDotStyle"
           TargetType="Ellipse"
           BasedOn="{StaticResource MediaResultDotStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.None}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.Safe}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.LowRisk}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.VerifyRecommended}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.HighRisk}">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A label with its value on the right, after a result dot when the value is marked. -->
    <DataTemplate x:Key="MediaExaminationRowTemplate" DataType="{x:Type viewModels:MediaDetail}">
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="MediaExaminationLabels" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
            <DockPanel Grid.Column="1" HorizontalAlignment="Right">
                <Ellipse Style="{StaticResource MediaRowResultDotStyle}" />
                <TextBlock Text="{Binding Value}"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Value}" />
            </DockPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MediaDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <Border Style="{StaticResource WfCardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <Border Margin="0,0,0,12"
                            Background="Black"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Focused}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid MinHeight="120">
                            <Image Source="{Binding FramePreview}"
                                   Stretch="Uniform"
                                   MaxHeight="240"
                                   AutomationProperties.Name="Movie frame preview" />
                            <TextBlock Text="{Binding PreviewStatus}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16" />
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,12">
                        <!-- No fill until the pointer is over it. -->
                        <Button DockPanel.Dock="Right"
                                Padding="4"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Copy details"
                                AutomationProperties.Name="Copy details"
                                Command="{Binding CopyDetailsCommand}"
                                Content="&#xE8C8;"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Style="{StaticResource WfTransparentButtonStyle}" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="&#xE7BA;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Focused.HasWarning, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                   ToolTip="{Binding Focused.Warning}"
                                   AutomationProperties.Name="Conversion warning" />
                        <TextBlock Text="{Binding Focused.Name, TargetNullValue='Select a file to view details', FallbackValue='Select a file to view details'}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <!-- Before an operation produces a file: one value per label. -->
                    <ItemsControl ItemsSource="{Binding Focused.DetailRows}"
                                  Grid.IsSharedSizeScope="True"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Visibility="{Binding Focused.ShowsResultComparison, Converter={StaticResource WfInverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:MediaDetail}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MediaDetailLabels" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
                                    <DockPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <Ellipse Style="{StaticResource MediaRowResultDotStyle}" />
                                        <TextBlock Text="{Binding Value}"
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}"
                                                   Style="{StaticResource MediaDetailValueTextStyle}" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="1"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Value}"
                                               Style="{StaticResource MediaDetailFileLinkTextStyle}">
                                        <Hyperlink Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   AutomationProperties.Name="Open file location">
                                            <Run Text="{Binding Value, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- After an operation produced a file: the original and the result side by side. -->
                    <StackPanel Grid.IsSharedSizeScope="True"
                                TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding Focused.ShowsResultComparison, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MediaComparisonLabels" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="Original"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2"
                                       Text="Result"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Focused.DetailRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MediaDetail}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MediaComparisonLabels" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
                                        <DockPanel Grid.Column="1" Margin="0,0,12,0">
                                            <Ellipse Style="{StaticResource MediaRowResultDotStyle}" />
                                            <TextBlock Text="{Binding Value}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}"
                                                       Style="{StaticResource MediaDetailValueTextStyle}" />
                                        </DockPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Result}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Result}"
                                                   Style="{StaticResource MediaDetailValueTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DataContext.Focused.Path, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Margin="0,0,12,0"
                                                   Style="{StaticResource MediaDetailFileLinkTextStyle}">
                                            <Hyperlink Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       AutomationProperties.Name="Open file location">
                                                <Run Text="{Binding Value, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DataContext.Focused.Result.Output, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   Style="{StaticResource MediaDetailFileLinkTextStyle}">
                                            <Hyperlink Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       AutomationProperties.Name="Show result file">
                                                <Run Text="{Binding Result, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Content="{Binding Focused.NextStepText}"
                            CommandParameter="{Binding Focused}"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0"
                            AutomationProperties.Name="Next step">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Scan">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Command" Value="{Binding ScanRowCommand}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Inspect">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Command" Value="{Binding InspectIncompleteCommand}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Convert">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Command" Value="{Binding ConvertRowCommand}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Retry analysis">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Command" Value="{Binding RetryAnalysisCommand}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Restore to DV7">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Command" Value="{Binding RestoreRowCommand}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Open output">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Command" Value="{Binding OpenOutputCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- What a scan or inspection measured, the limits it used, and each scan sample. -->
                    <StackPanel Grid.IsSharedSizeScope="True"
                                Margin="0,16,0,0"
                                TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Visibility="{Binding Focused.HasExamination, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="What the examination found"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Focused.ExaminationRows}"
                                      ItemTemplate="{StaticResource MediaExaminationRowTemplate}" />
                        <TextBlock Text="{Binding Focused.ExaminationNote}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                        <Expander Header="{Binding Focused.SampleSummary}"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding Focused.HasSampleRows, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <ItemsControl ItemsSource="{Binding Focused.SampleRows}"
                                          ItemTemplate="{StaticResource MediaExaminationRowTemplate}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          AutomationProperties.Name="Scan samples" />
                        </Expander>
                    </StackPanel>
                    <Expander Header="Library history"
                              Margin="0,12,0,0"
                              Visibility="{Binding Focused.HasLibraryHistory, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding Focused.LibraryHistory}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Expander>
                    <TextBlock Text="{Binding Focused.DetailNotes}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,12,0,0" />
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,24,0,0"
                            Padding="0,16,0,0"
                            Visibility="{Binding Focused.HasResult, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="Last operation result"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MediaResultLabels" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Status"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Ellipse DataContext="{Binding Focused.Result}" Style="{StaticResource MediaOperationResultDotStyle}" />
                                    <TextBlock Text="{Binding Focused.Result.Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Focused.ResultFiles}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:ResultFile}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MediaResultLabels" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}">
                                                <Hyperlink Command="{Binding DataContext.ShowResultFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding Path}"
                                                           AutomationProperties.Name="{Binding Label, StringFormat='Show {0} file'}">
                                                    <Run Text="{Binding Path, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Focused.Result.Message}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DataTemplate>
</ResourceDictionary>
