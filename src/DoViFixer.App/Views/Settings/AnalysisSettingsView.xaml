<UserControl x:Class="DoViFixer.App.Views.Settings.AnalysisSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WpfFoundation.Behaviors;assembly=WpfFoundation"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="AnalysisNoteTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource WfSettingNoteTextStyle}">
            <Setter Property="Margin" Value="0,8,0,12" />
        </Style>
        <Style x:Key="AnalysisResetButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="&#xE777;" />
            <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Reset to default" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Analysis" Style="{StaticResource WfHeadingTextStyle}" />
            <TextBlock Text="Choose quick-scan coverage, full-inspection brightness, and FEL classification thresholds."
                       TextWrapping="Wrap"
                       Style="{StaticResource AnalysisNoteTextStyle}" />
            <TextBlock Text="Quick scan" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <HeaderedContentControl Header="Clips per video" Style="{StaticResource WfSettingRowStyle}">
                        <!-- Keep the reset slot reserved when its button is hidden. -->
                        <StackPanel Orientation="Horizontal" Width="248">
                            <TextBox Text="{Binding ScanSampleCountText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="208"
                                     Margin="0,0,8,0"
                                     behaviors:TextBoxAssist.Placeholder="10"
                                     behaviors:TextBoxAssist.Suffix="clips"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Clips per video"
                                     AutomationProperties.HelpText="Valid range: 1 to 100 clips." />
                            <Button Style="{StaticResource AnalysisResetButtonStyle}"
                                    Visibility="{Binding IsScanSampleCountModified, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                    Command="{Binding ResetScanSampleCountCommand}"
                                    AutomationProperties.Name="Reset clips per video" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock Text="Default: 10. Select 1–100 clips, evenly distributed across the video."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                    <Separator />
                    <HeaderedContentControl Header="Clip length" Style="{StaticResource WfSettingRowStyle}">
                        <!-- Keep the reset slot reserved when its button is hidden. -->
                        <StackPanel Orientation="Horizontal" Width="248">
                            <TextBox Text="{Binding ScanSampleSecondsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="208"
                                     Margin="0,0,8,0"
                                     behaviors:TextBoxAssist.Placeholder="1"
                                     behaviors:TextBoxAssist.Suffix="seconds"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Clip length"
                                     AutomationProperties.HelpText="Valid range: 0.1 to 60 seconds." />
                            <Button Style="{StaticResource AnalysisResetButtonStyle}"
                                    Visibility="{Binding IsScanSampleSecondsModified, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                    Command="{Binding ResetScanSampleSecondsCommand}"
                                    AutomationProperties.Name="Reset clip length" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock Text="Default: 1 second. Select 0.1–60 seconds per clip. Stream-copy boundaries can make actual clip lengths differ."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                    <Separator />
                    <HeaderedContentControl Header="Required scan coverage" Style="{StaticResource WfSettingRowStyle}">
                        <!-- Keep the reset slot reserved when its button is hidden. -->
                        <StackPanel Orientation="Horizontal" Width="248">
                            <TextBox Text="{Binding MinimumScanCoveragePercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="208"
                                     Margin="0,0,8,0"
                                     behaviors:TextBoxAssist.Placeholder="100"
                                     behaviors:TextBoxAssist.Suffix="%"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Required scan coverage"
                                     AutomationProperties.HelpText="Valid range: 1 to 100 %." />
                            <Button Style="{StaticResource AnalysisResetButtonStyle}"
                                    Visibility="{Binding IsMinimumScanCoveragePercentModified, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                    Command="{Binding ResetMinimumScanCoveragePercentCommand}"
                                    AutomationProperties.Name="Reset required scan coverage" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock Text="Default: 100% (all clips). Select 1–100%. The required number of successful clips is rounded up."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                    <TextBlock Text="{Binding ScanCoverageSummary}"
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Full metadata inspection" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <HeaderedContentControl Header="Peak-brightness percentile" Style="{StaticResource WfSettingRowStyle}">
                        <!-- Keep the reset slot reserved when its button is hidden. -->
                        <StackPanel Orientation="Horizontal" Width="248">
                            <TextBox Text="{Binding InspectionPeakPercentileText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="208"
                                     Margin="0,0,8,0"
                                     behaviors:TextBoxAssist.Placeholder="100"
                                     behaviors:TextBoxAssist.Suffix="%"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Peak-brightness percentile"
                                     AutomationProperties.HelpText="Valid range: 1 to 100 percent. 100 uses the brightest frame." />
                            <Button Style="{StaticResource AnalysisResetButtonStyle}"
                                    Visibility="{Binding IsInspectionPeakPercentileModified, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                    Command="{Binding ResetInspectionPeakPercentileCommand}"
                                    AutomationProperties.Name="Reset peak-brightness percentile" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock Text="Default: 100% (maximum). For example, 99.9% excludes the brightest 0.1% of frame metadata values. Lower values can hide real brightness expansion."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                    <TextBlock Text="Applies to full metadata inspection, including conversion planning. Scan uses clip maxima; Deep Inspection compares every frame without percentile filtering."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Complex FEL detection" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <HeaderedContentControl Header="Brightness margin"
                                            Style="{StaticResource WfSettingRowStyle}">
                        <!-- Keep the reset slot reserved when its button is hidden. -->
                        <StackPanel Orientation="Horizontal" Width="248">
                            <TextBox Text="{Binding BrightnessMarginText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="208"
                                     Margin="0,0,8,0"
                                     behaviors:TextBoxAssist.Placeholder="50"
                                     behaviors:TextBoxAssist.Suffix="nits"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Brightness margin"
                                     AutomationProperties.HelpText="Brightness difference in nits. Valid range: 0 to 1000." />
                            <Button Style="{StaticResource AnalysisResetButtonStyle}"
                                    Visibility="{Binding IsBrightnessMarginModified, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                    Command="{Binding ResetBrightnessMarginCommand}"
                                    AutomationProperties.Name="Reset brightness margin" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <Slider Minimum="0"
                            Maximum="1000"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding BrightnessMarginNits}"
                            AutomationProperties.Name="Brightness margin slider"
                            Margin="0,8" />
                    <TextBlock Text="Default: 50 nits. A smaller margin classifies more FEL files as Complex. A larger margin can miss brightness expansion."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                    <Separator />
                    <HeaderedContentControl Header="Assumed peak brightness"
                                            Style="{StaticResource WfSettingRowStyle}">
                        <!-- Keep the reset slot reserved when its button is hidden. -->
                        <StackPanel Orientation="Horizontal" Width="248">
                            <TextBox Text="{Binding AssumedPeakBrightnessText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="208"
                                     Margin="0,0,8,0"
                                     behaviors:TextBoxAssist.Placeholder="1000"
                                     behaviors:TextBoxAssist.Suffix="nits"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Assumed peak brightness"
                                     AutomationProperties.HelpText="Fallback peak brightness in nits. Valid range: 100 to 10000." />
                            <Button Style="{StaticResource AnalysisResetButtonStyle}"
                                    Visibility="{Binding IsAssumedPeakBrightnessModified, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                    Command="{Binding ResetAssumedPeakBrightnessCommand}"
                                    AutomationProperties.Name="Reset assumed peak brightness" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <Slider Minimum="100"
                            Maximum="10000"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding AssumedPeakBrightnessNits}"
                            AutomationProperties.Name="Assumed peak brightness slider"
                            Margin="0,8" />
                    <TextBlock Text="Default: 1,000 nits. Used for scan and regular inspection only when MaxCLL is missing, invalid, or below 100 nits. Results identify this value as assumed."
                               TextWrapping="Wrap"
                               Style="{StaticResource AnalysisNoteTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="How the comparison works"
                       Style="{StaticResource WfLabelTextStyle}"
                       Margin="0,16,0,0" />
            <TextBlock Text="Scan and regular inspection classify FEL as Complex when the Dolby Vision L1 peak exceeds MaxCLL (or the assumed peak) plus the margin."
                       TextWrapping="Wrap"
                       Style="{StaticResource AnalysisNoteTextStyle}" />
            <TextBlock Text="Deep Inspection uses the same margin against each measured base-layer frame. It does not use the assumed peak."
                       TextWrapping="Wrap"
                       Style="{StaticResource AnalysisNoteTextStyle}" />
            <TextBlock Text="Brightness comparisons are heuristics. They do not prove that removing FEL picture data is safe. Changes apply to future analysis and conversion planning; existing results remain until analyzed again."
                       TextWrapping="Wrap"
                       Style="{StaticResource AnalysisNoteTextStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
