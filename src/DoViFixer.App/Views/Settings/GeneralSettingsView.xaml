<UserControl x:Class="DoViFixer.App.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:updates="clr-namespace:DoViFixer.Application.Updates;assembly=DoViFixer.Application"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <!-- The General page of the settings frame. Its DataContext is the SettingsViewModel all pages share. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="General" Style="{StaticResource WfHeadingTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <HeaderedContentControl Header="App theme"
                                            AutomationProperties.HelpText="{Binding Source={x:Static updates:ApplicationTitle.Name}, StringFormat='Select whether {0} follows your Windows system color theme, or uses Light or Dark theme.'}"
                                            Style="{StaticResource WfSettingRowStyle}">
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  AutomationProperties.Name="App theme"
                                  Width="220" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WfCardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="File list"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <CheckBox Content="Show check boxes to select files"
                              AutomationProperties.HelpText="When on, check the files to process, and clicking a row only shows its details. When off, select files as in File Explorer: click, Ctrl+click, Shift+click or Ctrl+A. Also on the View menu."
                              IsChecked="{Binding ShowSelectionCheckBoxes}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WfCardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Notifications"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <CheckBox Content="Show a notification when an operation finishes"
                              AutomationProperties.HelpText="When a scan, conversion, backup or restore finishes while the window is minimized or behind another app, Windows shows a notification. The taskbar button shows progress either way. Do not disturb and the app's switch in Windows Settings still apply."
                              IsChecked="{Binding ShowCompletionNotifications}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WfCardStyle}" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="File Explorer"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <CheckBox Content="{x:Static updates:ApplicationTitle.Name}"
                              ContentStringFormat="Show Open in {0} and Convert with {0} when you right-click a movie or folder"
                              AutomationProperties.HelpText="Right-click MKV files or a folder in File Explorer to add them to the list, or to add and convert them as the Convert button does. On Windows 10, and on Windows 11 until this PC trusts the certificate of the app's menu package, the commands are under Show more options. The commands start the app from its current folder; open the app once after you move it."
                              IsChecked="{Binding ShowInFileExplorerMenu}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <StackPanel Visibility="{Binding OffersWindows11Menu, Converter={StaticResource WfBooleanToVisibilityConverter}}">
                        <TextBlock Text="Windows 11 shows the commands under Show more options until this PC trusts the certificate of the app's File Explorer package. Trusting it needs an administrator once."
                                   Style="{StaticResource WfSettingNoteTextStyle}" />
                        <Button Content="Show in the Windows 11 menu…"
                                Command="{Binding ShowInWindows11MenuCommand}"
                                AutomationProperties.HelpText="Windows asks for administrator permission to trust the certificate on this PC. The certificate only lets Windows accept the app's File Explorer package."
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
