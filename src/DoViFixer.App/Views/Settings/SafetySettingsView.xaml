<UserControl x:Class="DoViFixer.App.Views.Settings.SafetySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WpfFoundation.Behaviors;assembly=WpfFoundation"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Safety" Style="{StaticResource WfHeadingTextStyle}" />
            <TextBlock Text="Choose how conversions are checked and how original and backup files are handled."
                       TextWrapping="Wrap"
                       Style="{StaticResource WfSettingNoteTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <TextBlock Text="Verification level" Style="{StaticResource WfLabelTextStyle}" />
                    <Grid IsEnabled="{Binding IsIdle}" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Most thorough" HorizontalAlignment="Center" />
                            <Slider Minimum="1"
                                    Maximum="4"
                                    TickFrequency="1"
                                    TickPlacement="Both"
                                    IsSnapToTickEnabled="True"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    Height="128"
                                    Margin="0,12"
                                    Value="{Binding VerificationLevel}"
                                    AutomationProperties.Name="Verification level" />
                            <TextBlock Text="Fastest" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="16,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding VerificationTitle}"
                                           Style="{StaticResource WfLabelTextStyle}" />
                                <TextBlock Text="{Binding VerificationDescription}"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0" />
                                <TextBlock Text="Lower levels check fewer properties. Level 1 can replace the original without content verification."
                                           TextWrapping="Wrap"
                                           Margin="0,24,0,0"
                                           Style="{StaticResource WfSettingNoteTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WfCardStyle}" Margin="0,12,0,0">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Deletion" Style="{StaticResource WfLabelTextStyle}" />
                    <CheckBox Content="Move deleted originals and backups to Recycle Bin"
                              IsChecked="{Binding RecycleDeletedOriginalsAndBackups}"
                              Style="{StaticResource WfToggleSwitchStyle}"
                              Margin="0,12,0,0" />
                    <TextBlock Text="Applies after replacing an original and to approved backup cleanup. Temporary files are removed normally. Windows may permanently delete files that exceed its Recycle Bin limit."
                               TextWrapping="Wrap"
                               Style="{StaticResource WfSettingNoteTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WfCardStyle}" Margin="0,12,0,0">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Disk space" Style="{StaticResource WfLabelTextStyle}" />
                    <HeaderedContentControl Header="Extra free-space margin"
                                            AutomationProperties.HelpText="Additional free space, as a percentage of the source file, required before conversion. Valid range: 0 to 200 percent."
                                            Style="{StaticResource WfSettingRowStyle}"
                                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding FreeSpaceMarginText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Width="160"
                                     behaviors:TextBoxAssist.Placeholder="20"
                                     behaviors:TextBoxAssist.Suffix="%"
                                     AutomationProperties.HelpText="Extra free-space margin in percent. Valid range: 0 to 200."
                                     AutomationProperties.Name="Extra free-space margin" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <TextBlock Text="This margin is added to DoViFixer’s existing workspace and output estimates."
                               TextWrapping="Wrap"
                               Style="{StaticResource WfSettingNoteTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
