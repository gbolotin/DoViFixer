<UserControl x:Class="DoViFixer.App.Views.Settings.ConversionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <!-- The Conversion page of the settings frame. Its DataContext is the SettingsViewModel all pages share. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Conversion" Style="{StaticResource WfHeadingTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <HeaderedContentControl Header="Temporary storage folder"
                                            AutomationProperties.HelpText="Working space for extracted video, Dolby Vision metadata and verification files during scans, inspections, conversions, backups and restores. Each operation uses its own subfolder and attempts to remove it when finished, including after failure or cancellation. Final output files use the output folder selected below. Leave blank to use the Windows temporary folder."
                                            Style="{StaticResource WfStackedSettingRowStyle}">
                        <DockPanel>
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Command="{Binding BrowseTemporaryCommand}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding Temporary}" AutomationProperties.Name="Temporary storage folder" />
                        </DockPanel>
                    </HeaderedContentControl>
                    <Separator />
                    <HeaderedContentControl Header="Output folder"
                                            AutomationProperties.HelpText="Where converted files are written."
                                            Style="{StaticResource WfSettingRowStyle}">
                        <ComboBox AutomationProperties.Name="Output folder" Width="220">
                            <ComboBoxItem Content="Same folder as source" IsSelected="{Binding OtherFolder, Converter={StaticResource WfInverseBooleanConverter}}" />
                            <ComboBoxItem Content="Other output folder" IsSelected="{Binding OtherFolder}" />
                        </ComboBox>
                    </HeaderedContentControl>
                    <DockPanel Visibility="{Binding OtherFolder, Converter={StaticResource WfBooleanToVisibilityConverter}}" Margin="0,0,0,12">
                        <Button Content="Browse"
                                DockPanel.Dock="Right"
                                Command="{Binding BrowseDestinationCommand}"
                                Margin="8,0,0,0" />
                        <TextBox Text="{Binding Destination}" AutomationProperties.Name="Output folder path" />
                    </DockPanel>
                    <TextBlock Text="{Binding DestinationError}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="File handling and policy" Style="{StaticResource WfLabelTextStyle}" />
                    <CheckBox Content="Replace original after verification"
                              AutomationProperties.HelpText="The converted file replaces the source file once verification succeeds. When off, the original is kept."
                              IsChecked="{Binding ReplaceOriginal}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <Separator />
                    <CheckBox Content="Create EL archive by default"
                              AutomationProperties.HelpText="Saves the enhancement layer in an archive so the original file can be restored from Backup &amp; Restore."
                              IsChecked="{Binding CreateArchive}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <Separator />
                    <CheckBox Content="Include Simple FEL conversion"
                              IsChecked="{Binding IncludeSimple}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <TextBlock Style="{StaticResource WfSettingNoteTextStyle}">
                        <Run Text="&#xE7BA;"
                             FontFamily="{StaticResource SymbolThemeFontFamily}"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <Run Text="Enhancement-layer picture data will be discarded. Simple FEL contains minimal picture data and does not expand dynamic range beyond the base layer, but the original enhancement-layer video track is not retained in the converted file." />
                    </TextBlock>
                    <Separator />
                    <CheckBox Content="Force Complex FEL conversion"
                              IsChecked="{Binding ForceComplex}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <TextBlock Style="{StaticResource WfSettingNoteTextStyle}">
                        <Run Text="&#xE7BA;"
                             FontFamily="{StaticResource SymbolThemeFontFamily}"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <Run Text="Active enhancement-layer picture data will be permanently lost. Complex FEL contains video data that expands dynamic range and brightness beyond the base layer. Discarding it during conversion removes this visual detail." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
