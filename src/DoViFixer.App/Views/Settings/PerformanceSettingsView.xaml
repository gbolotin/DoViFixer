<UserControl x:Class="DoViFixer.App.Views.Settings.PerformanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <!-- Performance settings share the parent settings view model. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <TextBlock Text="Performance" Style="{StaticResource WfHeadingTextStyle}" />
            <TextBlock Text="Concurrency" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding HardwareSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConcurrencyRecommendation}"
                               Style="{StaticResource WfSettingNoteTextStyle}"
                               Margin="0,8,0,12" />
                    <Separator />
                    <HeaderedContentControl Header="Simultaneous conversions"
                                            AutomationProperties.HelpText="Maximum files converted at once. Additional files wait in the queue. More workers require more temporary and output disk space. The recommended value is based on physical CPU cores."
                                            Style="{StaticResource WfSettingRowStyle}">
                        <ComboBox ItemsSource="{Binding ConversionWorkerChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ConversionWorkers}"
                                  MinWidth="208"
                                  AutomationProperties.Name="Simultaneous conversions" />
                    </HeaderedContentControl>
                    <Separator />
                    <HeaderedContentControl Header="Concurrent scan clips"
                                            AutomationProperties.HelpText="Maximum scan clips analyzed together within one video. Set the total clip count under Analysis. This does not run full inspections in parallel. The recommended value is based on physical CPU cores."
                                            Style="{StaticResource WfSettingRowStyle}">
                        <ComboBox ItemsSource="{Binding AnalysisWorkerChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding AnalysisWorkers}"
                                  MinWidth="208"
                                  AutomationProperties.Name="Concurrent scan clips" />
                    </HeaderedContentControl>
                    <TextBlock Text="This controls concurrency, not the total clip count. Set Clips per video under Analysis. Videos are scanned one at a time."
                               Style="{StaticResource WfSettingNoteTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="System impact" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <HeaderedContentControl Header="Tool process priority"
                                            AutomationProperties.HelpText="CPU priority for native tools. Below Normal leaves more CPU time for other applications. Above Normal can reduce responsiveness."
                                            Style="{StaticResource WfSettingRowStyle}">
                        <ComboBox ItemsSource="{Binding ToolPriorityChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ToolProcessPriority}"
                                  MinWidth="208"
                                  AutomationProperties.Name="Tool process priority" />
                    </HeaderedContentControl>
                    <TextBlock Text="Below normal is recommended when you use the computer during a batch. Priority does not limit disk usage."
                               Style="{StaticResource WfSettingNoteTextStyle}" />
                    <Separator />
                    <HeaderedContentControl Header="Video pipe buffer (KiB)"
                                            AutomationProperties.HelpText="Buffer size for video passed between native tools. 1024 KiB equals 1 MiB. Larger buffers use more memory per active pipeline."
                                            Style="{StaticResource WfSettingRowStyle}">
                        <ComboBox ItemsSource="{Binding PipeBufferChoices}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding PipeBufferKiB}"
                                  MinWidth="208"
                                  AutomationProperties.Name="Video pipe buffer (KiB)" />
                    </HeaderedContentControl>
                    <TextBlock Text="4096 KiB (4 MiB) is recommended. Transformed video pipelines buffer both reading and writing. Changes apply to tools started afterward."
                               Style="{StaticResource WfSettingNoteTextStyle}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Scanning &amp; library" Style="{StaticResource WfLabelTextStyle}" />
            <Border Style="{StaticResource WfCardStyle}">
                <StackPanel>
                    <CheckBox Content="Automatically scan added files"
                              AutomationProperties.HelpText="Starts a scan as soon as files are added to the Media list."
                              IsChecked="{Binding AutomaticallyScanAddedFiles}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <Separator />
                    <CheckBox Content="Reuse saved results for Scan and Convert"
                              AutomationProperties.HelpText="Applies to Scan and Convert. Inspect and Deep Inspect always analyze again. Successful results are always saved."
                              IsChecked="{Binding UseCachedResults}"
                              Style="{StaticResource WfToggleSwitchStyle}" />
                    <TextBlock Text="Inspect and Deep Inspect always analyze again. Successful results are always saved."
                               Style="{StaticResource WfSettingNoteTextStyle}"
                               Margin="0,8,0,12" />
                    <Separator />
                    <DockPanel Margin="0,12">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="24,0,0,0">
                            <Button Content="Clean library"
                                    Command="{Binding CleanLibraryCommand}"
                                    ToolTip="Remove library records for files that no longer exist. Media files, existing records and frame previews are kept." />
                            <Button Content="Delete library"
                                    Command="{Binding DeleteLibraryCommand}"
                                    ToolTip="Delete all remembered file records, saved analyses and history. Also clears the current list. Media files and frame previews are kept."
                                    Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Media library" />
                            <TextBlock Text="{Binding LibrarySizeText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       ToolTip="Allocated database space for analysis and history. Cleaning removes missing records but may not shrink the database file."
                                       Margin="0,4,0,0" />
                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       ToolTip="{Binding LibraryDirectory}">
                                <Run Text="Location: " /><Hyperlink Command="{Binding OpenLibraryFolderCommand}"
                                           AutomationProperties.Name="Open library folder">
                                    <Run Text="{Binding LibraryDirectory, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
