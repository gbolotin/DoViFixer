<UserControl x:Class="DoViFixer.App.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:WpfFoundation.Behaviors;assembly=WpfFoundation"
             xmlns:wfc="clr-namespace:WpfFoundation.Controls;assembly=WpfFoundation"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:views="clr-namespace:DoViFixer.App.Views"
             xmlns:updates="clr-namespace:DoViFixer.Application.Updates;assembly=DoViFixer.Application"
             xmlns:operations="clr-namespace:DoViFixer.Application.Operations;assembly=DoViFixer.Application"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MediaViewModel}">
    <UserControl.Resources>
        <!-- Detail values: plain text on every row except the file row, which shows a link instead. -->
        <Style x:Key="MediaDetailValueTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Label}" Value="{x:Static viewModels:MediaRow.FileLocationLabel}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MediaDetailFileLinkTextStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Label}" Value="{x:Static viewModels:MediaRow.FileLocationLabel}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Result dots: a small circle before a result's text, colored by how the operation ended. -->
        <Style x:Key="MediaResultDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <!-- Bound to an OperationItemResult. -->
        <Style x:Key="MediaOperationResultDotStyle"
               TargetType="Ellipse"
               BasedOn="{StaticResource MediaResultDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Completed}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Partial}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Cancelled}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static operations:OperationStatus.Failed}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Bound to a MediaRow; colored by risk and outcome. -->
        <Style x:Key="MediaRowResultDotStyle"
               TargetType="Ellipse"
               BasedOn="{StaticResource MediaResultDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.None}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.Safe}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.LowRisk}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.VerifyRecommended}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.HighRisk}">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MediaToolBarTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,0"
                    Margin="0,0,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    Padding="8,8">
                <WrapPanel>
                    <Button Content="Add files"
                            Tag="{StaticResource WfIconAddFiles}"
                            ContentTemplate="{StaticResource WfIconContentTemplate}"
                            Command="{Binding AddFilesCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Add folder"
                            Tag="{StaticResource WfIconAddFolder}"
                            ContentTemplate="{StaticResource WfIconContentTemplate}"
                            Command="{Binding AddFolderCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Clear all"
                            Tag="&#xEA99;"
                            ContentTemplate="{StaticResource WfIconContentTemplate}"
                            Command="{Binding ClearAllCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Remove missing"
                            Tag="&#xE74D;"
                            ContentTemplate="{StaticResource WfIconContentTemplate}"
                            Command="{Binding RemoveMissingCommand}"
                            Visibility="{Binding HasMissingFiles, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                            Margin="0,0,8,0">
                        <Button.ToolTip>
                            <TextBlock Text="{Binding Source={x:Static updates:ApplicationTitle.Name}, StringFormat='Remove files that were deleted, moved or renamed outside {0} from the list.'}" />
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Export selected results"
                            Command="{Binding ExportSelectedResultsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Export visible results"
                            Command="{Binding ExportVisibleResultsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="&#xE72C;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Padding="8"
                            Command="{Binding ScanCommand}"
                            ToolTip="Rescan"
                            Margin="0,0,8,0" />
                    <Border Width="1"
                            Margin="4,4,12,4"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <!-- Like the Visual Studio Start button; picking from the menu runs that entry and makes it what the button runs. -->
                    <wfc:SplitButton Margin="0,0,8,0">
                        <wfc:SplitButton.Style>
                            <Style TargetType="wfc:SplitButton" BasedOn="{StaticResource WfSplitButtonStyle}">
                                <Setter Property="Content" Value="Inspect" />
                                <Setter Property="Icon" Value="&#xE721;" />
                                <Setter Property="Command" Value="{Binding InspectCommand}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeepInspectionChosen}" Value="True">
                                        <Setter Property="Content" Value="Deep Inspect" />
                                        <Setter Property="Icon" Value="&#xE9D9;" />
                                        <Setter Property="Command" Value="{Binding DeepInspectCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </wfc:SplitButton.Style>
                        <wfc:SplitButton.DropDownMenu>
                            <ContextMenu>
                                <MenuItem Header="Inspect"
                                          Command="{Binding ChooseInspectCommand}"
                                          ToolTip="Verify the full RPU metadata stream (recommended for FEL and incomplete scans)."
                                          IsChecked="{Binding IsDeepInspectionChosen, Mode=OneWay, Converter={StaticResource WfInverseBooleanConverter}}" />
                                <MenuItem Header="Deep Inspect"
                                          Command="{Binding ChooseDeepInspectCommand}"
                                          ToolTip="Expert check (slow). Slow frame-by-frame luminance check for experts only."
                                          IsChecked="{Binding IsDeepInspectionChosen, Mode=OneWay}" />
                            </ContextMenu>
                        </wfc:SplitButton.DropDownMenu>
                    </wfc:SplitButton>
                    <Button Content="Convert"
                            Command="{Binding ConvertCommand}"
                            ToolTip="{Binding OutputSummaryToolTip}"
                            Tag="&#xE8AB;"
                            ContentTemplate="{StaticResource WfIconContentTemplate}" />
                </WrapPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediaListTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <ListView ItemsSource="{Binding Files}"
                      SelectedItem="{Binding Focused}"
                      wf:GridViewLayout.IsEnabled="True"
                      wf:GridViewLayout.State="{Binding ColumnLayout, Mode=TwoWay}"
                      wf:GridViewSizing.LastColumnMinimumWidth="176"
                      wf:GridViewSort.Sort="{Binding FileSort}"
                      wf:ListFilter.Predicate="{Binding ShownFilePredicate}"
                      wf:ListFilter.LiveProperty="FilterGroup">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Reset columns" Command="{Binding ResetColumnLayoutCommand}" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource WfSortableColumnHeaderContainerStyle}" ColumnHeaderTemplate="{StaticResource WfSortableColumnHeaderTemplate}">
                        <GridViewColumn Header="File"
                                        wf:GridViewLayout.Id="Name"
                                        Width="150"
                                        wf:GridViewSort.Key="{x:Static viewModels:MediaSortColumn.Name}">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="1,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding DataContext.AllFilesSelected, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Select all / none"
                                                      AutomationProperties.Name="Select all or clear all files" />
                                            <TextBlock Text="File" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource WfColumnSortIndicatorStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,8">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding SelectionEnabled}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Include file" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Format"
                                        wf:GridViewLayout.Id="Format"
                                        Width="120"
                                        wf:GridViewSort.Key="{x:Static viewModels:MediaSortColumn.Classification}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Format}"
                                               ToolTip="{Binding Classification}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Result"
                                        wf:GridViewLayout.Id="Result"
                                        Width="128"
                                        wf:GridViewSort.Key="{x:Static viewModels:MediaSortColumn.Status}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Ellipse>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource MediaRowResultDotStyle}">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding State}" Value="{x:Static viewModels:MediaRowState.Converted}" />
                                                                    <Condition Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.Safe}" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       AutomationProperties.Name="Conversion completed">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding State}" Value="{x:Static viewModels:MediaRowState.Converted}" />
                                                                    <Condition Binding="{Binding StatusTone}" Value="{x:Static viewModels:MediaStatusTone.Safe}" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding StatusToolTip}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static viewModels:MediaRow.MissingStatus}">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE7BA;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                                       ToolTip="{Binding Warning}"
                                                       AutomationProperties.Name="Conversion warning" />
                                        </Grid>
                                        <TextBlock Text="{Binding ResultRecommendation}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Margin="0,4,4,4" Visibility="{Binding IsActive, Converter={StaticResource WfBooleanToVisibilityConverter}}">
                                            <StackPanel DataContext="{Binding Progress}">
                                                <TextBlock Text="{Binding Stage}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Stage}" />
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding StageProgressText}"
                                                               DockPanel.Dock="Right"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                               FontSize="{StaticResource CaptionTextBlockFontSize}"
                                                               Margin="8,0,0,0" />
                                                    <ProgressBar Value="{Binding StagePercent, Mode=OneWay}"
                                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                                 Height="6"
                                                                 VerticalAlignment="Center"
                                                                 AutomationProperties.Name="Current job stage progress" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Analysis"
                                        wf:GridViewLayout.Id="Analysis"
                                        Width="96"
                                        wf:GridViewSort.Key="{x:Static viewModels:MediaSortColumn.Analysis}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AnalysisText}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Actions"
                                        Width="176"
                                        wf:GridViewLayout.Id="Actions"
                                        wf:GridViewSizing.IsFillColumn="True">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- One primary action per row, in priority order, right-aligned against the fixed hover
                                             actions so no action moves when another appears or disappears. -->
                                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                                            <Grid.Resources>
                                                <!-- A shared minimum width keeps the actions of different rows lined up in one column. -->
                                                <Style x:Key="RowPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource WfIconContentTemplate}" />
                                                    <Setter Property="Padding" Value="7,6" />
                                                    <Setter Property="Margin" Value="4" />
                                                    <Setter Property="MinWidth" Value="88" />
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </Style>
                                            </Grid.Resources>
                                            <Button Content="Cancel"
                                                    Tag="&#xE711;"
                                                    Style="{StaticResource RowPrimaryActionButtonStyle}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.CancelFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Skip"
                                                    Tag="&#xE893;"
                                                    Style="{StaticResource RowPrimaryActionButtonStyle}"
                                                    Visibility="{Binding IsPending, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Retry"
                                                    Tag="&#xE72C;"
                                                    Style="{StaticResource RowPrimaryActionButtonStyle}"
                                                    Visibility="{Binding CanRetryAnalysis, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.RetryAnalysisCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Inspect"
                                                    Tag="&#xE721;"
                                                    Command="{Binding DataContext.InspectIncompleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding CanInspectIncomplete}" Value="True" />
                                                                    <Condition Binding="{Binding CanRetryAnalysis}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="Convert"
                                                    Tag="&#xE8AB;"
                                                    ToolTip="Convert"
                                                    AutomationProperties.Name="Convert"
                                                    Command="{Binding DataContext.ConvertRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NextStepText}" Value="Convert">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <!-- Hover actions are only ever Hidden, never Collapsed, so each keeps its own fixed slot. -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Padding="4"
                                                    Margin="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Restore to DV7 from .dovi archive"
                                                    AutomationProperties.Name="Restore to DV7"
                                                    Command="{Binding DataContext.RestoreRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE7A7;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource WfTransparentButtonStyle}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CanRestore}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Padding="4"
                                                    Margin="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Remove"
                                                    AutomationProperties.Name="Remove from list"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE74D;"
                                                    FontFamily="{StaticResource SymbolThemeFontFamily}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource WfTransparentButtonStyle}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DataTemplate>

        <DataTemplate x:Key="MediaDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Border Style="{StaticResource WfCardStyle}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Margin="0,0,0,12"
                                Background="Black"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Focused}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinHeight="120">
                                <Image Source="{Binding FramePreview}"
                                       Stretch="Uniform"
                                       MaxHeight="240"
                                       AutomationProperties.Name="Movie frame preview" />
                                <TextBlock Text="{Binding PreviewStatus}"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="16" />
                            </Grid>
                        </Border>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="&#xE7BA;"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Focused.HasWarning, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                       ToolTip="{Binding Focused.Warning}"
                                       AutomationProperties.Name="Conversion warning" />
                            <TextBlock Text="{Binding Focused.Name, TargetNullValue='Select a file to view details', FallbackValue='Select a file to view details'}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <!-- Before an operation produces a file: one value per label. -->
                        <ItemsControl ItemsSource="{Binding Focused.DetailRows}"
                                      Grid.IsSharedSizeScope="True"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Visibility="{Binding Focused.ShowsResultComparison, Converter={StaticResource WfInverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:MediaDetail}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="MediaDetailLabels" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
                                        <DockPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Ellipse Style="{StaticResource MediaRowResultDotStyle}" />
                                            <TextBlock Text="{Binding Value}"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}"
                                                       Style="{StaticResource MediaDetailValueTextStyle}" />
                                        </DockPanel>
                                        <TextBlock Grid.Column="1"
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}"
                                                   Style="{StaticResource MediaDetailFileLinkTextStyle}">
                                            <Hyperlink Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       AutomationProperties.Name="Open file location">
                                                <Run Text="{Binding Value, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- After an operation produced a file: the original and the result side by side. -->
                        <StackPanel Grid.IsSharedSizeScope="True"
                                    TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Visibility="{Binding Focused.ShowsResultComparison, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MediaComparisonLabels" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Text="Original"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2"
                                           Text="Result"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Focused.DetailRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:MediaDetail}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="MediaComparisonLabels" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
                                            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                                                <Ellipse Style="{StaticResource MediaRowResultDotStyle}" />
                                                <TextBlock Text="{Binding Value}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Value}"
                                                           Style="{StaticResource MediaDetailValueTextStyle}" />
                                            </DockPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Result}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Result}"
                                                       Style="{StaticResource MediaDetailValueTextStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DataContext.Focused.Path, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Margin="0,0,12,0"
                                                       Style="{StaticResource MediaDetailFileLinkTextStyle}">
                                                <Hyperlink Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           AutomationProperties.Name="Open file location">
                                                    <Run Text="{Binding Value, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DataContext.Focused.Result.Output, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       Style="{StaticResource MediaDetailFileLinkTextStyle}">
                                                <Hyperlink Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           AutomationProperties.Name="Show result file">
                                                    <Run Text="{Binding Result, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Content="{Binding Focused.NextStepText}"
                                CommandParameter="{Binding Focused}"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="Next step">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Scan">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Command" Value="{Binding ScanRowCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Inspect">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Command" Value="{Binding InspectIncompleteCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Convert">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Command" Value="{Binding ConvertRowCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Retry analysis">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Command" Value="{Binding RetryAnalysisCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Restore to DV7">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Command" Value="{Binding RestoreRowCommand}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Focused.NextStepText}" Value="Open output">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Command" Value="{Binding OpenOutputCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Expander Header="Library history"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding Focused.HasLibraryHistory, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Focused.LibraryHistory}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Expander>
                        <TextBlock Text="{Binding Focused.DetailNotes}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,12,0,0" />
                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,24,0,0"
                                Padding="0,16,0,0"
                                Visibility="{Binding Focused.HasResult, Converter={StaticResource WfBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <StackPanel Grid.IsSharedSizeScope="True">
                                <TextBlock Text="Last operation result"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MediaResultLabels" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Ellipse DataContext="{Binding Focused.Result}" Style="{StaticResource MediaOperationResultDotStyle}" />
                                        <TextBlock Text="{Binding Focused.Result.Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Focused.ResultFiles}"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ResultFile}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MediaResultLabels" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1"
                                                           TextAlignment="Right"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}">
                                                    <Hyperlink Command="{Binding DataContext.ShowResultFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               CommandParameter="{Binding Path}"
                                                               AutomationProperties.Name="{Binding Label, StringFormat='Show {0} file'}">
                                                        <Run Text="{Binding Path, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Focused.Result.Message}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediaListWithDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 wf:TextBoxAssist.Placeholder="Search"
                                 AutomationProperties.Name="Filter files"
                                 Style="{StaticResource WfSearchTextBoxStyle}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <ScrollViewer Grid.Column="1"
                                      HorizontalAlignment="Right"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FilterOptions}"
                                          Focusable="False"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Show files">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:MediaFilterOption}">
                                        <RadioButton Content="{Binding Label}"
                                                     GroupName="MediaFileFilter"
                                                     IsChecked="{Binding IsSelected}"
                                                     Style="{DynamicResource {x:Type ToggleButton}}"
                                                     Visibility="{Binding IsVisible, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                                                     Margin="0,0,8,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaListTemplate}" />
                        <TextBlock Text="No files match this filter."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNoShownFiles, Converter={StaticResource WfBooleanToVisibilityConverter}}" />
                    </Grid>
                </DockPanel>
                <GridSplitter Grid.Column="1"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="False"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext">
                    <GridSplitter.Resources>
                        <SolidColorBrush x:Key="GridsplitterBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="GridsplitterBackgroundPressed" Color="Transparent" />
                    </GridSplitter.Resources>
                </GridSplitter>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaDetailsTemplate}" Grid.Column="2"/>
            </Grid>
        </DataTemplate>

        <!-- The percent has a fixed width wide enough for "100%", so its bar never shifts. While a bar is indeterminate the percent is left empty. -->
        <Style x:Key="ProgressPercentTextStyle" TargetType="TextBlock">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="ProgressIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- One step of the current job's stepper: a check once completed, a spinning ring while active, an empty ring while pending. -->
        <DataTemplate x:Key="JobStepTemplate" DataType="{x:Type viewModels:JobStep}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Width="20" Height="20">
                    <Ellipse x:Name="Ring"
                             Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                             StrokeThickness="1.5" />
                    <Ellipse x:Name="Done"
                             Fill="{DynamicResource AccentFillColorDefaultBrush}"
                             Visibility="Collapsed" />
                    <TextBlock x:Name="Check"
                               Text="&#xE73E;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="{StaticResource CaptionTextBlockFontSize}"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Path x:Name="Arc"
                          Data="M 10,1 A 9,9 0 0 1 19,10"
                          Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="Collapsed">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <Rectangle x:Name="Connector"
                           Grid.Column="1"
                           Height="1"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding Name}"
                           Margin="0,4,8,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="{Binding StateText}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:JobStepState.Completed}">
                    <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Connector" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:JobStepState.Active}">
                    <Setter TargetName="Arc" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Spin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Arc"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0"
                                                 To="360"
                                                 Duration="0:0:1"
                                                 RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="Spin" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Laid out like the job card mockup: preview and file, step progress and steps, then times and Cancel. -->
        <DataTemplate x:Key="MediaActiveProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ProgressPercent" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Keep cancellation beside the batch pause control. -->
                        <Button Style="{StaticResource ProgressIconButtonStyle}"
                                Content="{Binding PauseBatchIcon}"
                                ToolTip="{Binding PauseBatchToolTip}"
                                AutomationProperties.Name="{Binding PauseBatchText}"
                                Command="{Binding PauseBatchCommand}"
                                Visibility="{Binding BatchProgress.IsRunning, Converter={StaticResource WfBooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource ProgressIconButtonStyle}"
                                Content="&#xE711;"
                                ToolTip="Cancel batch"
                                AutomationProperties.Name="Cancel batch"
                                Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveProgressTitle}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ProgressPercentTextStyle}">
                            <Setter Property="Text" Value="{Binding ActiveProgressText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveProgressIndeterminate}" Value="True">
                                    <Setter Property="Text" Value="" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Row="1"
                             Grid.Column="1"
                             VerticalAlignment="Center"
                             Value="{Binding ActiveProgressPercent, Mode=OneWay, FallbackValue=0}"
                             IsIndeterminate="{Binding ActiveProgressIndeterminate}"
                             Height="8"
                             AutomationProperties.Name="Overall progress" />
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="{Binding ActiveProgressSummary}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding ActiveProgressToolTip}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MediaProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Border Style="{StaticResource WfCardStyle}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaActiveProgressTemplate}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EmptyMediaPanelTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <StackPanel x:Name="EmptyMediaPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="440"
                        Margin="24">
                <TextBlock Text="No media files"
                           Style="{StaticResource WfHeadingTextStyle}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="Drag and drop MKV files or folders here, or use the buttons below."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="Add files"
                            Tag="{StaticResource WfIconAddFiles}"
                            ContentTemplate="{StaticResource WfIconContentTemplate}"
                            Command="{Binding AddFilesCommand}"
                            Style="{StaticResource WfPrimaryButtonStyle}"
                            Margin="4" />
                    <Button Content="Add folder"
                            Tag="{StaticResource WfIconAddFolder}"
                            ContentTemplate="{StaticResource WfIconContentTemplate}"
                            Command="{Binding AddFolderCommand}"
                            Margin="4" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="Transparent"
          AllowDrop="True"
          wf:FileDrop.Command="{Binding AddDroppedPathsCommand}"
          Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource EmptyMediaPanelTemplate}"
                        Grid.RowSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsFileListEmpty, Converter={StaticResource WfBooleanToVisibilityConverter}}" />
        <ContentControl Content="{Binding}"
                        Visibility="{Binding IsFileListEmpty, Converter={StaticResource WfInverseBooleanToVisibilityConverter}}"
                        ContentTemplate="{StaticResource MediaToolBarTemplate}"
                        Margin="0,0,0,8" />
        <ContentControl Content="{Binding}"
                        Visibility="{Binding IsFileListEmpty, Converter={StaticResource WfInverseBooleanToVisibilityConverter}}"
                        ContentTemplate="{StaticResource MediaListWithDetailsTemplate}"
                        Grid.Row="1"
                        Margin="0,0,0,0"/>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource MediaProgressTemplate}"
                        Margin="0,8,0,0"
                        Grid.Row="2"
                        Visibility="{Binding IsBusy, Converter={StaticResource WfBooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
