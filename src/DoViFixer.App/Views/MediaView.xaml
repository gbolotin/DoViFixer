<UserControl x:Class="DoViFixer.App.Views.MediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>

        <DataTemplate x:Key="MediaToolBarTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <StackPanel Orientation="Horizontal">
                <Button Content="＋  Add files" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" />
                <Button Content="▱  Add folder" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" />
                <Button Content="Clear all" Command="{Binding ClearAllCommand}" Margin="0,0,8,0" />
                <Button Content="⌕  Scan" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Content="◎  Inspect ▾" Click="ShowInspectionMenu" IsEnabled="{Binding CanInspect}" Margin="0,0,8,0">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Standard inspection" Command="{Binding InspectCommand}" />
                            <MenuItem Header="Deep inspection" Command="{Binding DeepInspectCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="▷  Convert" Command="{Binding ConvertCommand}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaListTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <ListView ItemsSource="{Binding Files}" SelectedItem="{Binding Focused}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="File" Width="238">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                                        <CheckBox IsChecked="{Binding DataContext.AllFilesSelected, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Select all / none"
                                                  AutomationProperties.Name="Select all or clear all files" />
                                        <TextBlock Text="File" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,8">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding SelectionEnabled}"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Include file" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding PlannedOutput}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding PlannedOutput}"
                                                       Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PlannedOutput}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PlannedOutput}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Profile / Type" Width="180">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Profile / Type" Margin="1,0,0,0" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Classification}"
                                               Foreground="{Binding ClassificationColor}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Status / Action" Width="255">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Status / Action" Margin="1,0,0,0" />
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Status}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Details}" />
                                                <TextBlock Text="⚠"
                                                           Foreground="#FFD166"
                                                           FontWeight="SemiBold"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource Visible}}"
                                                           ToolTip="{Binding Warning}"
                                                           AutomationProperties.Name="Conversion warning" />
                                            </StackPanel>
                                            <StackPanel Margin="0,4,4,4" Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                                                <StackPanel DataContext="{Binding Progress}">
                                                    <TextBlock Text="{Binding Stage}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Stage}" />
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding StageProgressText}"
                                                                   DockPanel.Dock="Right"
                                                                   Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                                                   FontSize="12"
                                                                   Margin="8,0,0,0" />
                                                        <ProgressBar Value="{Binding StagePercent, Mode=OneWay}"
                                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                                     Height="6"
                                                                     VerticalAlignment="Center"
                                                                     AutomationProperties.Name="Current job stage progress" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Cancel"
                                                    Padding="7,6"
                                                    Margin="4"
                                                    Visibility="{Binding IsActive, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.CancelFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Retry"
                                                    Padding="7,6"
                                                    Margin="4"
                                                    Visibility="{Binding CanRetryAnalysis, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.RetryAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Inspect"
                                                    Padding="7,6"
                                                    Margin="4"
                                                    Visibility="{Binding CanInspectIncomplete, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.InspectIncompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Open folder"
                                                    Padding="7,6"
                                                    Margin="4"
                                                    Visibility="{Binding CanOpenResult, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.OpenRowOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Skip"
                                                    Padding="7,6"
                                                    Margin="4"
                                                    Visibility="{Binding IsPending, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DataTemplate>

        <DataTemplate x:Key="MediaDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected file details" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding Focused.Name, TargetNullValue='Select a file to view details', FallbackValue='Select a file to view details'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="{Binding Focused.Details}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,20,0,0"
                                Padding="0,16,0,0">
                            <TextBlock Text="{Binding Focused.ResultDetails}" TextWrapping="Wrap" />
                        </Border>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Open output folder"
                                    Command="{Binding OpenOutputCommand}"
                                    Margin="0,0,8,8"
                                    Padding="10,8" />
                            <Button Content="View logs"
                                    Command="{Binding OpenLogsCommand}"
                                    Margin="0,0,0,8"
                                    Padding="10,8" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediaListWithDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaListTemplate}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaDetailsTemplate}" Grid.Column="2"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MediaConversionOptionTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Conversion options" Style="{StaticResource Heading}" />
                    <Grid IsEnabled="{Binding IsIdle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Target" FontWeight="SemiBold" />
                            <RadioButton Content="Profile 8.1"
                                 GroupName="Target"
                                 IsChecked="{Binding Hdr10, Converter={StaticResource Inverse}}" />
                            <RadioButton Content="HDR10"
                                 GroupName="Target"
                                 IsChecked="{Binding Hdr10}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Destination" FontWeight="SemiBold" />
                            <RadioButton Content="Same folder as source"
                                 GroupName="Destination"
                                 IsChecked="{Binding OtherFolder, Converter={StaticResource Inverse}}" />
                            <RadioButton Content="Other folder"
                                 GroupName="Destination"
                                 IsChecked="{Binding OtherFolder}" />
                            <DockPanel IsEnabled="{Binding OtherFolder}">
                                <Button Content="Browse"
                                Command="{Binding BrowseDestinationCommand}"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="10,6" />
                                <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Output folder" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="File handling" FontWeight="SemiBold" />
                            <RadioButton Content="Keep original"
                                 GroupName="Retention"
                                 IsChecked="{Binding ReplaceOriginal, Converter={StaticResource Inverse}}" />
                            <RadioButton Content="Replace original after verification"
                                 GroupName="Retention"
                                 IsChecked="{Binding ReplaceOriginal}" />
                            <CheckBox Content="Create enhancement-layer archive (EL)" IsChecked="{Binding CreateArchive}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer MaxHeight="180"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,12">
                        <TextBlock Text="{Binding Review}"
                           Foreground="#FFD166"
                           TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close options"
                        Command="{Binding CloseOptionsCommand}"
                        Margin="0,0,8,0" />
                        <Button Content="Review changes"
                        Command="{Binding ReviewCommand}"
                        Margin="0,0,8,0" />
                        <Button Content="▷  Approve and start"
                        Style="{StaticResource Primary}"
                        Command="{Binding ApproveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediaStatusTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <StackPanel Orientation="Horizontal" TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <TextBlock Text="{Binding SelectionSummary}" />
                <TextBlock Text=" | " />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaCurrentJobProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Content="Cancel job"
                        Command="{Binding CancelFileCommand}"
                        CommandParameter="{Binding BatchProgress.CurrentJob}"
                        Margin="8,0,0,0" />
                <StackPanel>
                    <DockPanel Margin="0,8,0,8" TextBlock.FontSize="22">
                        <TextBlock Text="{Binding BatchProgress.CurrentJob.Progress.ProgressText}"
                                   DockPanel.Dock="Right"
                                   Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                   Margin="12,0,0,0" />
                        <TextBlock Text="{Binding BatchProgress.CurrentJob.Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding BatchProgress.CurrentJob.Path}"
                                    TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding BatchProgress.CurrentJob.Progress.Percent, Mode=OneWay, FallbackValue=0}"
                                 IsIndeterminate="{Binding BatchProgress.CurrentJob.Progress.IsIndeterminate, FallbackValue=False}"
                                 Height="8"
                                 AutomationProperties.Name="Current job progress" />
                    <TextBlock Text="{Binding BatchProgress.CurrentJob.Progress.Stage}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaActiveProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Cancel batch"
                            Command="{Binding CancelCommand}"
                            Margin="8,0,0,0" />
                    <Button Content="{Binding PauseBatchText}"
                            Command="{Binding PauseBatchCommand}"
                            Visibility="{Binding BatchProgress.IsRunning, Converter={StaticResource Visible}}"
                            ToolTip="Pause before the next job starts, or resume the batch."
                            Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel>
                    <DockPanel Margin="0,8,0,8" TextBlock.FontSize="16">
                        <TextBlock Text="{Binding ActiveProgressText}"
                                   DockPanel.Dock="Right"
                                   Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                   Margin="12,0,0,0" />
                        <TextBlock Text="{Binding ActiveProgressTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ActiveProgressPercent, Mode=OneWay, FallbackValue=0}"
                                 IsIndeterminate="{Binding ActiveProgressIndeterminate}"
                                 Height="8"
                                 AutomationProperties.Name="Overall progress" />
                    <TextBlock Text="{Binding ActiveProgressSummary}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding ActiveProgressToolTip}" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="MediaProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource MediaActiveProgressTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Margin" Value="0,0,0,16" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatchProgress.CurrentJob}" Value="{x:Null}">
                                        <Setter Property="Margin" Value="0" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding BatchProgress.IsRunning}" Value="True" />
                                            <Condition Binding="{Binding BatchProgress.Total}" Value="1" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource MediaCurrentJobProgressTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="{Binding BatchProgress.IsRunning, Converter={StaticResource Visible}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatchProgress.CurrentJob}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource MediaToolBarTemplate}"
                        Margin="0,0,0,16"/>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource MediaListWithDetailsTemplate}"
                        Grid.Row="1"/>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource MediaConversionOptionTemplate}"
                        Grid.Row="2"
                        Margin="0,14,0,0"
                        Visibility="{Binding OptionsOpen, Converter={StaticResource Visible}}"/>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource MediaProgressTemplate}"
                        Margin="0,8,0,0"
                        Grid.Row="3"
                        Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource MediaStatusTemplate}"
                        Grid.Row="4"
                        Margin="0,8,0,0"/>
    </Grid>

</UserControl>
