<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:DoViFixer.App.Presentation.Common"
                    xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
                    xmlns:analysis="clr-namespace:DoViFixer.Domain.Analysis;assembly=DoViFixer.Domain">

    <DataTemplate x:Key="MediaToolBarTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <StackPanel>
            <WrapPanel>
                <Button Content="Add files"
                        Tag="&#xE8A5;"
                        ContentTemplate="{StaticResource AddIconButtonContent}"
                        Command="{Binding AddFilesCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Add folder"
                        Tag="&#xE8B7;"
                        ContentTemplate="{StaticResource AddIconButtonContent}"
                        Command="{Binding AddFolderCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Clear all"
                        Tag="&#xEA99;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding ClearAllCommand}"
                        Margin="0,0,8,8" />
                <Button Content="Rescan"
                        Tag="&#xE72C;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding ScanCommand}"
                        ToolTip="Scan every file in the list and generate missing frame previews in the background. If automatic selection is enabled, selections are updated using the conversion policy in Settings."
                        Margin="0,0,8,8" />
                <Button Content="Inspect"
                        Tag="&#xE721;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding InspectCommand}"
                        Margin="0,0,8,8"/>
                <Button Content="Deep Inspect"
                        Tag="&#xE9D9;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding DeepInspectCommand}"
                        Margin="0,0,8,8"/>
                <Button Content="Convert to DV8.1"
                        Tag="&#xE8AB;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding ConvertDv81Command}"
                        ToolTip="{Binding OutputSummaryToolTip}"
                        Margin="0,0,8,8" />
                <Button Content="Convert to HDR10"
                        Tag="&#xE8AB;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding ConvertHdrCommand}"
                        ToolTip="{Binding OutputSummaryToolTip}"
                        Margin="0,0,0,8" />
            </WrapPanel>
            <DockPanel Margin="0,0,0,4">
                <Button Content="Settings"
                        Tag="&#xE713;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        DockPanel.Dock="Right"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="{Binding OutputSummaryToolTip}"
                        Margin="8,0,0,0" />
                <TextBlock Text="{Binding OutputSummary}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding OutputSummaryToolTip}"
                           VerticalAlignment="Center" />
            </DockPanel>
            <WrapPanel>
                <TextBlock Text="{Binding RetentionSummary}"
                           FontWeight="SemiBold"
                           Margin="0,0,16,4" />
                <TextBlock Text="{Binding FelSummary}" Margin="0,0,16,4" />
                <TextBlock Text="{Binding ArchiveSummary}" Margin="0,0,0,4" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MediaListTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <ListView ItemsSource="{Binding Files}"
                  SelectedItem="{Binding Focused}"
                  p:GridViewSizing.LastColumnMinimumWidth="255">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="238">
                        <GridViewColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                                    <CheckBox IsChecked="{Binding DataContext.AllFilesSelected, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              ToolTip="Select all / none"
                                              AutomationProperties.Name="Select all or clear all files" />
                                    <TextBlock Text="File" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.HeaderTemplate>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,8">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding SelectionEnabled}"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Include file" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}" />
                                        <TextBlock Text="{Binding PlannedOutput}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PlannedOutput}"
                                                   Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PlannedOutput}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PlannedOutput}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Profile / Type" Width="180">
                        <GridViewColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Profile / Type" Margin="1,0,0,0" />
                            </DataTemplate>
                        </GridViewColumn.HeaderTemplate>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Classification}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#A6B6C3" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Analysis.Verdict}" Value="{x:Static analysis:AnalysisVerdict.Mel}">
                                                    <Setter Property="Foreground" Value="#66D94B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.Verdict}" Value="{x:Static analysis:AnalysisVerdict.SimpleFel}">
                                                    <Setter Property="Foreground" Value="#29AEFA" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.Verdict}" Value="{x:Static analysis:AnalysisVerdict.ComplexFel}">
                                                    <Setter Property="Foreground" Value="#FF625A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.Verdict}" Value="{x:Static analysis:AnalysisVerdict.AnalysisFailed}">
                                                    <Setter Property="Foreground" Value="#FF625A" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.Verdict}" Value="{x:Static analysis:AnalysisVerdict.Unknown}">
                                                    <Setter Property="Foreground" Value="#FFD166" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Analysis.Verdict}" Value="{x:Static analysis:AnalysisVerdict.FelUnclassified}">
                                                    <Setter Property="Foreground" Value="#FFD166" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasAnalysisError}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF625A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Status / Action" Width="255">
                        <GridViewColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Status / Action" Margin="1,0,0,0" />
                            </DataTemplate>
                        </GridViewColumn.HeaderTemplate>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding StatusToolTip}" />
                                            <TextBlock Text="&#xE7BA;"
                                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource Visible}}"
                                                       ToolTip="{Binding Warning}"
                                                       AutomationProperties.Name="Conversion warning" />
                                        </StackPanel>
                                        <StackPanel Margin="0,4,4,4" Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                                            <StackPanel DataContext="{Binding Progress}">
                                                <TextBlock Text="{Binding Stage}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Stage}" />
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding StageProgressText}"
                                                               DockPanel.Dock="Right"
                                                               Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                                               FontSize="12"
                                                               Margin="8,0,0,0" />
                                                    <ProgressBar Value="{Binding StagePercent, Mode=OneWay}"
                                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                                 Height="6"
                                                                 VerticalAlignment="Center"
                                                                 AutomationProperties.Name="Current job stage progress" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Cancel"
                                                Tag="&#xE711;"
                                                ContentTemplate="{StaticResource IconButtonContent}"
                                                Padding="7,6"
                                                Margin="4"
                                                Visibility="{Binding IsActive, Converter={StaticResource Visible}}"
                                                Command="{Binding DataContext.CancelFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Retry"
                                                Tag="&#xE72C;"
                                                ContentTemplate="{StaticResource IconButtonContent}"
                                                Padding="7,6"
                                                Margin="4"
                                                Visibility="{Binding CanRetryAnalysis, Converter={StaticResource Visible}}"
                                                Command="{Binding DataContext.RetryAnalysisCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Inspect"
                                                Tag="&#xE721;"
                                                ContentTemplate="{StaticResource IconButtonContent}"
                                                Padding="7,6"
                                                Margin="4"
                                                Visibility="{Binding CanInspectIncomplete, Converter={StaticResource Visible}}"
                                                Command="{Binding DataContext.InspectIncompleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Open folder"
                                                Tag="&#xE8B7;"
                                                ContentTemplate="{StaticResource IconButtonContent}"
                                                Padding="7,6"
                                                Margin="4"
                                                Visibility="{Binding CanOpenResult, Converter={StaticResource Visible}}"
                                                Command="{Binding DataContext.OpenRowOutputCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Skip"
                                                Tag="&#xE893;"
                                                ContentTemplate="{StaticResource IconButtonContent}"
                                                Padding="7,6"
                                                Margin="4"
                                                Visibility="{Binding IsPending, Converter={StaticResource Visible}}"
                                                Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}" />
                                        <Button Padding="7,6"
                                                Margin="4"
                                                VerticalAlignment="Center"
                                                ToolTip="Restore to DV7 from .dovi archive"
                                                AutomationProperties.Name="Restore to DV7"
                                                Command="{Binding DataContext.RestoreRowCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE7A7;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanRestore}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Padding="7,6"
                                                Margin="4"
                                                VerticalAlignment="Center"
                                                ToolTip="Convert to DV8.1"
                                                AutomationProperties.Name="Convert to DV8.1"
                                                Command="{Binding DataContext.ConvertRowDv81Command, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE8AB;"
                                                FontFamily="{StaticResource SymbolThemeFontFamily}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProfile7}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Padding="7,6"
                                                Margin="4"
                                                VerticalAlignment="Center"
                                                ToolTip="Remove"
                                                AutomationProperties.Name="Remove from list"
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE74D;" 
                                                FontFamily="{StaticResource SymbolThemeFontFamily}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TransparentButton}">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DataTemplate>

    <DataTemplate x:Key="MediaDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <Border Margin="0,0,0,14"
                            Background="Black"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Focused}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid MinHeight="120">
                            <Image Source="{Binding FramePreview}"
                                   Stretch="Uniform"
                                   MaxHeight="240"
                                   AutomationProperties.Name="Movie frame preview" />
                            <TextBlock Text="{Binding PreviewStatus}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16" />
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="&#xE7BA;"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Focused.HasWarning, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
                                   ToolTip="{Binding Focused.Warning}"
                                   AutomationProperties.Name="Conversion warning" />
                        <TextBlock Text="{Binding Focused.Name, TargetNullValue='Select a file to view details', FallbackValue='Select a file to view details'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="Details"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Focused.DetailRows}"
                                  Grid.IsSharedSizeScope="True"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MediaDetailLabels" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Focused.DetailNotes}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,12,0,0" />
                    <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,20,0,0"
                            Padding="0,16,0,0">
                            <TextBlock Text="{Binding Focused.ResultDetails}" TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Open output folder"
                                Tag="&#xE8B7;"
                                ContentTemplate="{StaticResource IconButtonContent}"
                                Command="{Binding OpenOutputCommand}"
                                Margin="0,0,8,8"
                                Padding="10,8" />
                        <Button Content="View logs"
                                Tag="&#xE9F9;"
                                ContentTemplate="{StaticResource IconButtonContent}"
                                Command="{Binding OpenLogsCommand}"
                                Margin="0,0,0,8"
                                Padding="10,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MediaListWithDetailsTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaListTemplate}" />
            <GridSplitter Grid.Column="1"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext">
                <GridSplitter.Resources>
                    <SolidColorBrush x:Key="GridsplitterBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="GridsplitterBackgroundPressed" Color="Transparent" />
                </GridSplitter.Resources>
            </GridSplitter>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaDetailsTemplate}" Grid.Column="2"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MediaCurrentJobProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Content="Cancel job"
                    Tag="&#xE711;"
                    ContentTemplate="{StaticResource IconButtonContent}"
                    Command="{Binding CancelFileCommand}"
                    CommandParameter="{Binding BatchProgress.CurrentJob}"
                    Margin="8,0,0,0" />
            <StackPanel>
                <DockPanel Margin="0,8,0,8" TextBlock.FontSize="22">
                    <TextBlock Text="{Binding BatchProgress.CurrentJob.Progress.ProgressText}"
                               DockPanel.Dock="Right"
                               Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{Binding BatchProgress.CurrentJob.Name}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BatchProgress.CurrentJob.Path}"
                               TextBlock.Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DockPanel>
                <ProgressBar Value="{Binding BatchProgress.CurrentJob.Progress.Percent, Mode=OneWay, FallbackValue=0}"
                             IsIndeterminate="{Binding BatchProgress.CurrentJob.Progress.IsIndeterminate, FallbackValue=False}"
                             Height="8"
                             AutomationProperties.Name="Current job progress" />
                <TextBlock Text="{Binding BatchProgress.CurrentJob.Progress.Stage}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="MediaActiveProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Cancel batch"
                        Tag="&#xE711;"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding CancelCommand}"
                        Margin="8,0,0,0" />
                <Button Content="{Binding PauseBatchText}"
                        Tag="{Binding PauseBatchIcon}"
                        ContentTemplate="{StaticResource IconButtonContent}"
                        Command="{Binding PauseBatchCommand}"
                        Visibility="{Binding BatchProgress.IsRunning, Converter={StaticResource Visible}}"
                        ToolTip="Pause before the next job starts, or resume the batch."
                        Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel>
                <DockPanel Margin="0,8,0,8" TextBlock.FontSize="16">
                    <TextBlock Text="{Binding ActiveProgressText}"
                               DockPanel.Dock="Right"
                               Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{Binding ActiveProgressTitle}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </DockPanel>
                <ProgressBar Value="{Binding ActiveProgressPercent, Mode=OneWay, FallbackValue=0}"
                             IsIndeterminate="{Binding ActiveProgressIndeterminate}"
                             Height="8"
                             AutomationProperties.Name="Overall progress" />
                <TextBlock Text="{Binding ActiveProgressSummary}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="{Binding ActiveProgressToolTip}" />
            </StackPanel>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="MediaProgressTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaActiveProgressTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Margin" Value="0,0,0,16" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BatchProgress.CurrentJob}" Value="{x:Null}">
                                    <Setter Property="Margin" Value="0" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BatchProgress.IsRunning}" Value="True" />
                                        <Condition Binding="{Binding BatchProgress.Total}" Value="1" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource MediaCurrentJobProgressTemplate}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="{Binding BatchProgress.IsRunning, Converter={StaticResource Visible}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BatchProgress.CurrentJob}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="EmptyMediaPanelTemplate" DataType="{x:Type viewModels:MediaViewModel}">
        <StackPanel x:Name="EmptyMediaPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="440"
                    Margin="24">
            <TextBlock Text="No media files"
                       Style="{StaticResource Heading}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock Text="Drag and drop MKV files or folders here, or use the buttons below."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Add files"
                        Tag="&#xE8A5;"
                        ContentTemplate="{StaticResource AddIconButtonContent}"
                        Command="{Binding AddFilesCommand}"
                        Style="{StaticResource Primary}"
                        Margin="4" />
                <Button Content="Add folder"
                        Tag="&#xE8B7;"
                        ContentTemplate="{StaticResource AddIconButtonContent}"
                        Command="{Binding AddFolderCommand}"
                        Margin="4" />
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:MediaViewModel}">
        <Grid Background="Transparent"
              AllowDrop="True"
              p:FileDrop.Command="{Binding AddDroppedPathsCommand}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource EmptyMediaPanelTemplate}"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsFileListEmpty, Converter={StaticResource Visible}}" />
            <ContentControl Content="{Binding}"
                            Visibility="{Binding IsFileListEmpty, Converter={StaticResource InverseVisible}}"
                            ContentTemplate="{StaticResource MediaToolBarTemplate}"
                            Margin="0,0,0,16" />
            <ContentControl Content="{Binding}"
                            Visibility="{Binding IsFileListEmpty, Converter={StaticResource InverseVisible}}"
                            ContentTemplate="{StaticResource MediaListWithDetailsTemplate}"
                            Grid.Row="1" />
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource MediaProgressTemplate}"
                            Margin="0,8,0,0"
                            Grid.Row="2"
                            Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
