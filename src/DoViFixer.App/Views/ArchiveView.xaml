<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels">

    <DataTemplate DataType="{x:Type viewModels:ArchiveViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <StackPanel>
                <TextBlock Text="Backup &amp; Restore" Style="{StaticResource WfHeadingTextStyle}" />
                <Border Style="{StaticResource WfCardStyle}">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Enhancement-layer archives"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Choose a Profile 7 file for backup, or a Profile 8.1 / HDR10 base file for restoration."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,8"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Media file" Style="{StaticResource WfLabelTextStyle}" />
                        <DockPanel>
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Command="{Binding BrowseInputCommand}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="EL archive for restoration" Style="{StaticResource WfLabelTextStyle}" />
                        <DockPanel>
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Command="{Binding BrowseArchiveCommand}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding Archive, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="Output folder (leave blank for the source folder)" Style="{StaticResource WfLabelTextStyle}" />
                        <DockPanel>
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Command="{Binding BrowseOutputCommand}"
                                    Margin="8,0,0,0" />
                            <TextBox Text="{Binding Output, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <CheckBox Content="Allow a legacy archive without verified source pairing"
                                  IsChecked="{Binding AllowLegacy}"
                                  Margin="0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Review backup"
                                    Command="{Binding BackupCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Review restoration"
                                    Command="{Binding RestoreCommand}"
                                    Style="{StaticResource WfPrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WfCardStyle}" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Clean up retained backups"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Find .dovi and .bak.dovi_convert files in a folder and its subfolders. Review exact files before permanent deletion."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,12" />
                        <Button Content="Choose folder and review cleanup"
                                Command="{Binding CleanupCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <ProgressBar Margin="0,24,0,8"
                             Value="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource WfBooleanToVisibilityConverter}}" />
                <Button Content="Cancel operation"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                        HorizontalAlignment="Right" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>
