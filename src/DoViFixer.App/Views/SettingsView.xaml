<UserControl x:Class="DoViFixer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="Changes save automatically." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Saving settings…" Visibility="{Binding IsSaving, Converter={StaticResource Visible}}" />
            <StackPanel Visibility="{Binding HasSaveError, Converter={StaticResource Visible}}">
                <TextBlock Text="Changes could not be saved. Correct the settings, retry, or discard unsaved changes to continue."
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="Retry saving settings"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,8,4" />
                    <Button Content="Discard unsaved changes"
                            Command="{Binding DiscardChangesCommand}"
                            Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource Heading}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Appearance"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="App theme" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Width="180"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="Select whether DoViFixer follows your Windows system color theme, or uses Light or Dark theme."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Conversion options"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Temporary storage folder" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Command="{Binding BrowseTemporaryCommand}"
                                    Margin="10,0,0,0" />
                            <TextBox Text="{Binding Temporary}" />
                        </DockPanel>
                        <TextBlock Text="Working space for extracted video, Dolby Vision metadata and verification files during scans, inspections, conversions, backups and restores. Each operation uses its own subfolder and attempts to remove it when finished, including after failure or cancellation. Final output files use the output folder selected below. Leave blank to use the Windows temporary folder."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,6,0,12" />
                        <TextBlock Text="Output folder" Style="{StaticResource Label}" />
                        <RadioButton Content="Same folder as source"
                                     GroupName="DefaultDestination"
                                     IsChecked="{Binding OtherFolder, Converter={StaticResource Inverse}}" />
                        <RadioButton Content="Other output folder"
                                     GroupName="DefaultDestination"
                                     IsChecked="{Binding OtherFolder}" />
                        <DockPanel IsEnabled="{Binding OtherFolder}">
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Command="{Binding BrowseDestinationCommand}"
                                    Margin="10,0,0,0" />
                            <TextBox Text="{Binding Destination}" />
                        </DockPanel>
                        <TextBlock Text="{Binding DestinationError}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="File handling and policy" Style="{StaticResource Label}" />
                        <CheckBox Content="Replace original after verification by default" IsChecked="{Binding ReplaceOriginal}" />
                        <CheckBox Content="Create EL archive by default" IsChecked="{Binding CreateArchive}" />
                        <CheckBox Content="Include Simple FEL conversion" IsChecked="{Binding IncludeSimple}" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="20,2,0,8">
                            <Run Text="⚠ Warning: "
                                 FontWeight="SemiBold"
                                 Foreground="#FFD166" />
                            <Run Text="Enhancement-layer picture data will be discarded. Simple FEL contains minimal picture data and does not expand dynamic range beyond the base layer, but the original enhancement-layer video track is not retained in the converted file." />
                        </TextBlock>
                        <CheckBox Content="Force Complex FEL conversion" IsChecked="{Binding ForceComplex}" />
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="20,2,0,8">
                            <Run Text="⚠ Warning: "
                                 FontWeight="SemiBold"
                                 Foreground="#FFD166" />
                            <Run Text="Active enhancement-layer picture data will be permanently lost. Complex FEL contains video data that expands dynamic range and brightness beyond the base layer. Discarding it during conversion removes this visual detail." />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Scanning and analysis cache"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <CheckBox Content="Automatically scan added files" IsChecked="{Binding AutomaticallyScanAddedFiles}" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Use cached analysis results" IsChecked="{Binding UseCachedResults}" />
                            <Button Content="Clear analysis cache"
                                    Command="{Binding ClearCacheCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                        <CheckBox Content="Automatically select convertible files after scan" IsChecked="{Binding AutoSelectAfterScan}" />
                        <TextBlock Text="When disabled, scans and inspections analyze files again. Successful results are still saved."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Native tools"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,14">
                            <Button Content="Check tools"
                                    Command="{Binding CheckCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Dependency setup" Command="{Binding InstallCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <TextBlock>
                                            <Run Text="{Binding Tool}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding State}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Version}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Diagnostic}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10" IsEnabled="{Binding IsIdle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding ToolNames}"
                                      SelectedItem="{Binding SelectedTool}"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="10,0" />
                            <Button Grid.Column="2"
                                    Content="Browse"
                                    Command="{Binding BrowseToolCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Validate and save path"
                                    Command="{Binding SetToolCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Reset selected tool path" Command="{Binding ResetToolCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="Operation history, audit and diagnostics: %LOCALAPPDATA%\DoViFixer\Logs"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,20" />
                <ProgressBar Value="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Status}"
                           TextWrapping="Wrap"
                           Margin="0,12" />
                <Button Content="Cancel operation"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                        HorizontalAlignment="Right" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
