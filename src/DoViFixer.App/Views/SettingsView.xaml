<UserControl x:Class="DoViFixer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:DoViFixer.App.ViewModels"
             xmlns:settings="clr-namespace:DoViFixer.App.Views.Settings"
             xmlns:controls="clr-namespace:WpfFoundation.Controls;assembly=WpfFoundation"
             xmlns:navigation="clr-namespace:WpfFoundation.Navigation;assembly=WpfFoundation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}">
    <!-- The body of the settings frame: section navigation, the retained section pages, and a footer every section shares. -->
    <UserControl.Resources>
        <!-- Original speedometer outline, drawn on the PathIcon 16 by 16 grid. -->
        <StreamGeometry x:Key="PerformanceIconGeometry">F1 M2.37 12.25 A6.5 6.5 0 1 1 13.63 12.25 L12.77 11.75 A5.5 5.5 0 1 0 3.23 11.75 Z M4.101 7.153 L3.105 6.578 L3.455 5.972 L4.451 6.547 Z M5.547 5.451 L4.972 4.455 L5.578 4.105 L6.153 5.101 Z M7.650 4.700 L7.650 3.550 L8.350 3.550 L8.350 4.700 Z M9.847 5.101 L10.422 4.105 L11.028 4.455 L10.453 5.451 Z M11.549 6.547 L12.545 5.972 L12.895 6.578 L11.899 7.153 Z M7.25 8.25 L12.15 5.05 L8.75 9.75 Z M9.15 9 A1.15 1.15 0 1 1 6.85 9 A1.15 1.15 0 1 1 9.15 9 Z</StreamGeometry>
        <Style TargetType="TextBox" BasedOn="{StaticResource WfValidationOutlineTextBoxStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource WfValidationOutlineComboBoxStyle}" />
        <!-- Every section shows part of the same SettingsViewModel, so each page binds to it rather than to its section. -->
        <DataTemplate DataType="{x:Type viewModels:GeneralSettingsSection}">
            <settings:GeneralSettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PresetsSettingsSection}">
            <settings:PresetsSettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ConversionSettingsSection}">
            <settings:ConversionSettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AnalysisSettingsSection}"><settings:AnalysisSettingsView DataContext="{Binding Settings}" /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SafetySettingsSection}">
            <settings:SafetySettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:WatchFolderSettingsSection}">
            <settings:WatchFolderSettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PerformanceSettingsSection}"><settings:PerformanceSettingsView DataContext="{Binding Settings}" /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:NativeToolsSettingsSection}">
            <settings:NativeToolsSettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AboutSettingsSection}">
            <settings:AboutSettingsView DataContext="{Binding Settings}" />
        </DataTemplate>
    </UserControl.Resources>
    <!-- The footer comes last in the tab order, so opening the frame focuses the section list. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox ItemsSource="{Binding Sections.Pages}"
                 SelectedItem="{Binding Sections.CurrentPage}"
                 IsEnabled="{Binding Sections.CanNavigate}"
                 AutomationProperties.Name="Settings sections"
                 Style="{StaticResource WfNavigationSidebarStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="GlyphIcon"
                                   Text="{Binding NavigationIcon}"
                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                   FontSize="{StaticResource DefaultIconFontSize}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <controls:PathIcon x:Name="PerformanceIcon"
                                           Data="{StaticResource PerformanceIconGeometry}"
                                           Size="{StaticResource DefaultIconFontSize}"
                                           Visibility="Collapsed"
                                           Margin="0,0,8,0" />
                        <TextBlock Text="{Binding NavigationName}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <!-- Performance supplies a vector in place of a font glyph. -->
                        <DataTrigger Binding="{Binding NavigationIcon}" Value="{x:Null}">
                            <Setter TargetName="GlyphIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PerformanceIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <navigation:RetainedPageHost Grid.Column="1" Navigation="{Binding Sections}" />
        <!-- The window's status bar is behind the frame, so the frame shows save state, errors and progress itself. -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <StackPanel>
                <StackPanel Visibility="{Binding HasSaveError, Converter={StaticResource WfBooleanToVisibilityConverter}}" Margin="0,0,0,8">
                    <TextBlock Text="Changes could not be saved. Correct the settings, retry, or discard unsaved changes to continue."
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SaveError}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Retry saving settings"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,8,4" />
                        <Button Content="Discard unsaved changes"
                                Command="{Binding DiscardChangesCommand}"
                                Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding IsBusy, Converter={StaticResource WfBooleanToVisibilityConverter}}">
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Width="160"
                                     VerticalAlignment="Center"
                                     Margin="24,0,12,0" />
                        <Button Content="Cancel operation" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock Text="Changes save automatically."
                               DockPanel.Dock="Left"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActivePresetText}"
                               DockPanel.Dock="Left"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Text="Saving settings…"
                               DockPanel.Dock="Left"
                               Visibility="{Binding IsSaving, Converter={StaticResource WfBooleanToVisibilityConverter}}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
