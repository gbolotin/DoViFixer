<UserControl x:Class="DoViFixer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Card}">
                <StackPanel IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="Storage and conversion defaults"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Temporary storage folder" Style="{StaticResource Label}" />
                    <DockPanel>
                        <Button Content="Browse"
                                DockPanel.Dock="Right"
                                Command="{Binding BrowseTemporaryCommand}"
                                Margin="10,0,0,0" />
                        <TextBox Text="{Binding Temporary, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="Working space for extracted video, Dolby Vision metadata and verification files during scans, inspections, conversions, backups and restores. Each operation uses its own subfolder and attempts to remove it when finished, including after failure or cancellation. Final output files use the output folder selected below. Leave blank to use the Windows temporary folder. Conversion review shows the resolved folder and required scratch space for each file."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,12" />
                    <RadioButton Content="Same folder as source"
                                 GroupName="DefaultDestination"
                                 IsChecked="{Binding OtherFolder, Converter={StaticResource Inverse}}" />
                    <RadioButton Content="Other output folder"
                                 GroupName="DefaultDestination"
                                 IsChecked="{Binding OtherFolder}" />
                    <DockPanel IsEnabled="{Binding OtherFolder}">
                        <Button Content="Browse"
                                DockPanel.Dock="Right"
                                Command="{Binding BrowseDestinationCommand}"
                                Margin="10,0,0,0" />
                        <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <CheckBox Content="Replace original after verification by default" IsChecked="{Binding ReplaceOriginal}" />
                    <CheckBox Content="Create EL archive by default" IsChecked="{Binding CreateArchive}" />
                    <TextBlock Text="Scanning and analysis cache"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,18,0,8" />
                    <CheckBox Content="Automatically scan added files" IsChecked="{Binding AutomaticallyScanAddedFiles}" />
                    <CheckBox Content="Use cached analysis results" IsChecked="{Binding UseCachedResults}" />
                    <CheckBox Content="Automatically select convertible files after scan" IsChecked="{Binding AutoSelectAfterScan}" />
                    <TextBlock Text="When disabled, scans and inspections analyze files again. Successful results are still saved."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="Clear analysis cache"
                            Command="{Binding ClearCacheCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                    <TextBlock Text="Clears saved analysis only. Current displayed results remain; running scans may save new results."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Content="Save defaults"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource Primary}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Native tools"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,14">
                        <Button Content="Check tools"
                                Command="{Binding CheckCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Dependency setup" Command="{Binding InstallCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock>
                                        <Run Text="{Binding Tool}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding State}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Version}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Path}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Diagnostic}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10" IsEnabled="{Binding IsIdle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ToolNames}"
                                  SelectedItem="{Binding SelectedTool}"
                                  VerticalContentAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ToolPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0" />
                        <Button Grid.Column="2"
                                Content="Browse"
                                Command="{Binding BrowseToolCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Validate and save path"
                                Command="{Binding SetToolCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="Reset selected tool path" Command="{Binding ResetToolCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="DoViFixer · WPF&#xA;Operation history, audit and diagnostics: %LOCALAPPDATA%\DoViFixer\Logs"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,20" />
            <ProgressBar Value="{Binding Percent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Margin="0,12" />
            <Button Content="Cancel operation"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                    HorizontalAlignment="Right" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
