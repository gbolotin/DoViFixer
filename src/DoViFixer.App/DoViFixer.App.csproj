<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection that WpfFoundation.Notifications needs, and Windows 11's for registering the unsigned
         File Explorer package. The app still runs on Windows 10 version 2004; Windows 11 calls are guarded. -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>dovifixer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../DoViFixer.Application/DoViFixer.Application.csproj" />
    <ProjectReference Include="../DoViFixer.Infrastructure/DoViFixer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWpfFoundation)' == 'true'">
    <ProjectReference Include="$(WpfFoundationProject)" />
    <ProjectReference Include="$(WpfFoundationNotificationsProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWpfFoundation)' != 'true'">
    <PackageReference Include="WpfFoundation" />
    <PackageReference Include="WpfFoundation.Notifications" />
  </ItemGroup>
  <ItemGroup>
    <!-- The icon Windows shows on DoViFixer's notifications. -->
    <None Include="dovifixer.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window icon the title bar shows. -->
    <Resource Include="dovifixer.ico" />
  </ItemGroup>
</Project>
