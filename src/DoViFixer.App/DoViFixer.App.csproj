<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK projection that WpfFoundation.Notifications needs; only the WPF app sends notifications. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>dovifixer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../DoViFixer.Application/DoViFixer.Application.csproj" />
    <ProjectReference Include="../DoViFixer.Infrastructure/DoViFixer.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWpfFoundation)' == 'true'">
    <ProjectReference Include="$(WpfFoundationProject)" />
    <ProjectReference Include="$(WpfFoundationNotificationsProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWpfFoundation)' != 'true'">
    <PackageReference Include="WpfFoundation" />
    <PackageReference Include="WpfFoundation.Notifications" />
  </ItemGroup>
  <ItemGroup>
    <!-- The icon Windows shows on DoViFixer's notifications. -->
    <None Include="dovifixer.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
