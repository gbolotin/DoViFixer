<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- The app name in window titles, version text, help and the update-check user agent (read through ApplicationTitle). -->
    <AssemblyTitle>DoViFixer</AssemblyTitle>
  </PropertyGroup>
  <!-- One version for every DoViFixer assembly. Local builds are <VersionPrefix>-dev and pull request builds <VersionPrefix>-ci.<run>.
       Each push to main is released as VersionPrefix and tagged v<VersionPrefix> by CI (see .github/workflows/ci.yml), so bump it in every change.
       The SDK appends the commit hash to the informational version. -->
  <PropertyGroup>
    <VersionPrefix>0.1.8</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
  </PropertyGroup>
  <!-- DoViFixer.Local.sln builds against the WpfFoundation source next to this repository; every other build uses the pinned package.
       Only that solution lists the library project, and Visual Studio restore fails (NU1105) on a ProjectReference the open solution does not contain.
       -p:UseLocalWpfFoundation=true|false overrides. -->
  <PropertyGroup>
    <WpfFoundationProject>$(MSBuildThisFileDirectory)..\WpfFoundation\src\WpfFoundation\WpfFoundation.csproj</WpfFoundationProject>
    <WpfFoundationNotificationsProject>$(MSBuildThisFileDirectory)..\WpfFoundation\src\WpfFoundation.Notifications\WpfFoundation.Notifications.csproj</WpfFoundationNotificationsProject>
    <UseLocalWpfFoundation Condition="'$(UseLocalWpfFoundation)' == '' and '$(SolutionFileName)' == 'DoViFixer.Local.sln' and Exists('$(WpfFoundationProject)') and Exists('$(WpfFoundationNotificationsProject)')">true</UseLocalWpfFoundation>
  </PropertyGroup>
</Project>
