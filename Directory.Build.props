<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- One version for every DoViFixer assembly. Local builds are 0.1.0-dev, CI builds 0.1.0-ci.<run>, and a vX.Y.Z tag builds X.Y.Z (see .github/workflows/ci.yml).
       Bump VersionPrefix after each release. The SDK appends the commit hash to the informational version. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
  </PropertyGroup>
  <!-- DoViFixer.Local.sln builds against the WpfFoundation source next to this repository; every other build uses the pinned package.
       Only that solution lists the library project, and Visual Studio restore fails (NU1105) on a ProjectReference the open solution does not contain.
       -p:UseLocalWpfFoundation=true|false overrides. -->
  <PropertyGroup>
    <WpfFoundationProject>$(MSBuildThisFileDirectory)..\WpfFoundation\src\WpfFoundation\WpfFoundation.csproj</WpfFoundationProject>
    <UseLocalWpfFoundation Condition="'$(UseLocalWpfFoundation)' == '' and '$(SolutionFileName)' == 'DoViFixer.Local.sln' and Exists('$(WpfFoundationProject)')">true</UseLocalWpfFoundation>
  </PropertyGroup>
</Project>
