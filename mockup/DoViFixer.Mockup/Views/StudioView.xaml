<UserControl x:Class="DoViFixer.Mockup.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Studio.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28">
                <DockPanel Margin="0,0,0,24">
                    <TextBlock Text="DoViFixer"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Scan     Inspect     CONVERT     Backup &amp; Restore     Settings"
                               Foreground="{DynamicResource Accent}"
                               Margin="42,10,0,0" />
                    <TextBlock Text="● Tools ready"
                               HorizontalAlignment="Right"
                               Margin="10" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Conversion queue" Style="{StaticResource Heading}" />
                            <DataGrid ItemsSource="{Binding Files}"
                                      SelectedItem="{Binding SelectedFile}"
                                      MinHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="File"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="170"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Profile"
                                                        Binding="{Binding Profile}"
                                                        Width="95"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Analysis"
                                                        Binding="{Binding Analysis}"
                                                        Width="115"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Size"
                                                        Binding="{Binding Size}"
                                                        Width="90"
                                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding SelectionSummary}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,18,0,0" />
                            <TextBlock Text="Complex FEL: enhancement-layer picture data will be lost."
                                       Foreground="#F3BA60"
                                       Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedFile.Name}" Style="{StaticResource Heading}" />
                            <TextBlock Text="{Binding SelectedFile.InputPath}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="DOLBY VISION"
                                       Foreground="{DynamicResource Accent}"
                                       FontWeight="SemiBold"
                                       Margin="0,12" />
                            <TextBlock Text="{Binding SelectedFile.Profile}"
                                       FontSize="24"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="{Binding SelectedFile.Analysis}" Margin="0,0,0,20" />
                            <TextBlock Text="{Binding SelectedFile.Resolution}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding SelectedFile.Duration}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding SelectedFile.Size}" Style="{StaticResource MutedText}" />
                            <Separator Margin="0,12" />
                            <TextBlock Text="Target: Profile 8.1"
                                       FontSize="18"
                                       Margin="0,8" />
                            <TextBlock Text="{Binding Retention}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="{Binding SelectedFile.PictureNote}"
                                       TextWrapping="Wrap"
                                       Margin="0,12" />
                            <Button Content="Deep inspect sample"
                                    Command="{Binding InspectCommand}"
                                    Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="Current job • simulation" Style="{StaticResource Heading}" />
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="{Binding Stage}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Accent}" />
                            </DockPanel>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="Extract  →  Convert metadata  →  Remux  →  Verify"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,14,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Simulate conversion"
                                        Style="{StaticResource Primary}"
                                        Command="{Binding StartCommand}" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                                <Button Content="Reset demo" Command="{Binding ResetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}"
                           Style="{StaticResource MutedText}"
                           Margin="0,18,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
