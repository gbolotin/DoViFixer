<UserControl x:Class="DoViFixer.Mockup.Views.FluentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Canvas}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DoViFixer"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="12,0,0,30" />
                    <TextBlock Text="Scan" Style="{StaticResource Nav}" />
                    <TextBlock Text="Inspect" Style="{StaticResource Nav}" />
                    <TextBlock Text="Convert" Style="{StaticResource Nav}" />
                    <TextBlock Text="Backup &amp; Restore" Style="{StaticResource Nav}" />
                    <TextBlock Text="Settings" Style="{StaticResource Nav}" />
                    <TextBlock Text="● Tools ready (sample)"
                               Margin="12,48,0,8"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="Navigation preview"
                               Style="{StaticResource MutedText}"
                               Margin="12,12,0,0" />
                </StackPanel>
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Scan &amp; inspect" Style="{StaticResource Title}" />
                        <TextBlock Text="Explore your media and review a conversion plan." Style="{StaticResource MutedText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,22">
                            <Button Content="Load sample files" Command="{Binding ResetCommand}" />
                            <Button Content="Scan sample"
                                    Style="{StaticResource Primary}"
                                    Command="{Binding ScanCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}"
                                Padding="4"
                                Margin="0,0,18,0">
                            <DataGrid ItemsSource="{Binding Files}"
                                      SelectedItem="{Binding SelectedFile}"
                                      MinHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="File"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="170"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Profile"
                                                        Binding="{Binding Profile}"
                                                        Width="95"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Analysis"
                                                        Binding="{Binding Analysis}"
                                                        Width="115"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="Size"
                                                        Binding="{Binding Size}"
                                                        Width="90"
                                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedFile.Name}" Style="{StaticResource Heading}" />
                                <TextBlock Text="{Binding SelectedFile.InputPath}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="DOLBY VISION"
                                           Foreground="{DynamicResource Accent}"
                                           FontWeight="SemiBold"
                                           Margin="0,12" />
                                <TextBlock Text="{Binding SelectedFile.Profile}"
                                           FontSize="24"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding SelectedFile.Analysis}" Margin="0,0,0,20" />
                                <TextBlock Text="{Binding SelectedFile.Resolution}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedFile.Duration}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedFile.Size}" Style="{StaticResource MutedText}" />
                                <Separator Margin="0,12" />
                                <TextBlock Text="Target: Profile 8.1"
                                           FontSize="18"
                                           Margin="0,8" />
                                <TextBlock Text="{Binding Retention}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedFile.PictureNote}"
                                           TextWrapping="Wrap"
                                           Margin="0,12" />
                                <Button Content="Deep inspect sample"
                                        Command="{Binding InspectCommand}"
                                        Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2"
                            Style="{StaticResource Card}"
                            Margin="0,20,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Review conversion plan"
                                    Style="{StaticResource Primary}"
                                    Command="{Binding ReviewCommand}" />
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" />
                                <CheckBox Content="Keep original files" IsChecked="{Binding KeepOriginal}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Row="3"
                               Text="{Binding Status}"
                               Style="{StaticResource MutedText}"
                               Margin="0,18,0,0" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
