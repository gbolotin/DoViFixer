<Window x:Class="DoViFixer.Mockup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoViFixer • Design mockups"
        Width="1440"
        Height="950"
        MinWidth="1100"
        MinHeight="760"
        Background="#EEF1F5"
        FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#182330"
                Padding="20,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="MOCK DATA ONLY • No files are processed"
                           Foreground="#BDC9D6"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="VariantPicker"
                          Width="240"
                          HorizontalAlignment="Left"
                          SelectionChanged="OnVariantChanged"
                          SelectedIndex="0">
                    <ComboBoxItem Content="1 · Fluent workspace" />
                    <ComboBoxItem Content="2 · Studio console" />
                    <ComboBoxItem Content="3 · Guided workflow" />
                </ComboBox>
            </DockPanel>
        </Border>
        <ContentControl x:Name="VariantHost" />
    </DockPanel>
</Window>
